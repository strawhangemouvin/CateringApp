@model CateringApp.Models.Entity.KategoriMenu
@{
    ViewData["Title"] = "Tambah Kategori Menu";
}

<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Form Tambah Kategori</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="NamaKategori">Nama Kategori</label>
                        <input asp-for="NamaKategori" class="form-control" placeholder="Masukkan nama kategori" />
                        <span asp-validation-for="NamaKategori" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Deskripsi">Deskripsi</label>
                        <textarea asp-for="Deskripsi" class="form-control" rows="3" placeholder="Masukkan deskripsi"></textarea>
                        <span asp-validation-for="Deskripsi" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Simpan</button>
                    <a href="@Url.Action("Index")" class="btn btn-default">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>
