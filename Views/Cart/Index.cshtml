@model List<CateringApp.Models.ViewModel.CartItem>
@{
    ViewData["Title"] = "Keranjang Belanja";
    decimal total = Model.Sum(item => item.Subtotal);
}

<div class="container py-5">
    <!-- Step Indicator -->
    <div class="row mb-5 justify-content-center">
        <div class="col-md-10 text-center">
            <div class="d-flex justify-content-between position-relative" style="max-width: 600px; margin: 0 auto;">
                <div class="position-absolute" style="top: 20px; left: 10%; right: 10%; height: 4px; background-color: #e9ecef; z-index: 1;">
                    <div style="width: 0%; height: 100%; background-color: #28a745;"></div>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow" style="width: 45px; height: 45px; font-weight: bold;">1</div>
                    <span class="font-weight-bold text-dark" style="font-size: 0.85rem;">Keranjang</span>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-white text-muted border border-secondary d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px; font-weight: bold;">2</div>
                    <span class="text-muted" style="font-size: 0.85rem;">Pengiriman</span>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-white text-muted border border-secondary d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px; font-weight: bold;">3</div>
                    <span class="text-muted" style="font-size: 0.85rem;">Pembayaran</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 shadow-sm rounded-lg bg-white">
            <div class="mb-4 text-muted"><i class="fas fa-shopping-basket fa-5x"></i></div>
            <h3 class="font-weight-bold text-dark">Keranjang Belanja Anda Kosong</h3>
            <p class="text-secondary mb-4">Yuk, cari paket catering lezat untuk acara Anda di katalog kami!</p>
            <a href="@Url.Action("Katalog", "Pesanan")" class="btn btn-success btn-lg px-4"><i class="fas fa-store mr-2"></i> Belanja Sekarang</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Cart Items List -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm rounded-lg">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-shopping-cart mr-2 text-success"></i> Menu Terpilih</h4>
                        <span class="badge badge-success px-3 py-2 font-weight-bold">@Model.Count Item</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="min-width: 600px;">
                                <thead class="bg-light text-secondary font-weight-bold" style="font-size: 0.85rem; border-top: 1px solid #eef2f5;">
                                    <tr>
                                        <th scope="col" style="padding-left: 20px;">Menu Paket</th>
                                        <th scope="col" class="text-center">Harga</th>
                                        <th scope="col" class="text-center" style="width: 150px;">Jumlah Porsi</th>
                                        <th scope="col" class="text-right" style="padding-right: 20px;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr style="border-bottom: 1px solid #f1f3f5;">
                                            <td class="align-middle" style="padding-left: 20px; padding-top: 20px; padding-bottom: 20px;">
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.Gambar" class="rounded shadow-sm mr-3" style="width: 70px; height: 70px; object-fit: cover;" alt="@item.NamaPaket" />
                                                    <div>
                                                        <h6 class="font-weight-bold text-dark mb-1">@item.NamaPaket</h6>
                                                        <div class="d-flex flex-column">
                                                            <!-- Note Field -->
                                                            <small class="text-muted mb-1 d-block">Catatan khusus:</small>
                                                            <input type="text" 
                                                                   class="form-control form-control-sm note-input" 
                                                                   data-id="@item.PaketId" 
                                                                   value="@item.Catatan" 
                                                                   placeholder="Contoh: Tanpa jeroan, kuah dipisah..." 
                                                                   style="max-width: 250px; font-size: 0.8rem; border-radius: 4px; border: 1px solid #ced4da;" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle font-weight-bold text-dark">
                                                Rp @item.Harga.ToString("N0")
                                            </td>
                                            <td class="text-center align-middle">
                                                <!-- Quantity Control -->
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center">
                                                    <input type="hidden" name="id" value="@item.PaketId" />
                                                    <div class="input-group input-group-sm" style="width: 110px;">
                                                        <div class="input-group-prepend">
                                                            <button class="btn btn-outline-secondary btn-qty-dec" type="button" style="border-radius: 4px 0 0 4px;"><i class="fas fa-minus"></i></button>
                                                        </div>
                                                        <input type="number" 
                                                               name="qty" 
                                                               class="form-control text-center input-qty font-weight-bold" 
                                                               value="@item.Jumlah" 
                                                               min="1" 
                                                               max="1000" 
                                                               style="border-left: 0; border-right: 0;" />
                                                        <div class="input-group-append">
                                                            <button class="btn btn-outline-secondary btn-qty-inc" type="button" style="border-radius: 0 4px 4px 0;"><i class="fas fa-plus"></i></button>
                                                        </div>
                                                    </div>
                                                </form>
                                                <a href="@Url.Action("Remove", new { id = item.PaketId })" class="text-danger d-inline-block mt-2" style="font-size: 0.8rem; text-decoration: none;"><i class="fas fa-trash-alt mr-1"></i> Hapus</a>
                                            </td>
                                            <td class="text-right align-middle font-weight-bold text-success" style="padding-right: 20px; font-size: 1.05rem;">
                                                Rp @item.Subtotal.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Section -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-lg bg-white">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="font-weight-bold text-dark mb-0">Ringkasan Pesanan</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Subtotal Menu</span>
                            <span class="font-weight-bold text-dark">Rp @total.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-secondary">Biaya Kirim</span>
                            <span class="font-weight-bold text-success">Gratis</span>
                        </div>
                        <hr class="my-3" style="border-top: 1px dashed #e9ecef;" />
                        <div class="d-flex justify-content-between mb-4">
                            <h5 class="font-weight-bold text-dark">Grand Total</h5>
                            <h4 class="font-weight-bold text-success">Rp @total.ToString("N0")</h4>
                        </div>
                        <a href="@Url.Action("Checkout")" class="btn btn-success btn-block btn-lg py-3 font-weight-bold shadow rounded-lg mb-3" style="letter-spacing: 0.5px;">
                            Lanjut ke Pengiriman <i class="fas fa-arrow-right ml-2"></i>
                        </a>
                        <a href="@Url.Action("Katalog", "Pesanan")" class="btn btn-outline-secondary btn-block py-2 font-weight-bold rounded-lg" style="font-size: 0.9rem;">
                            <i class="fas fa-plus mr-2"></i> Tambah Menu Lain
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Decrease Qty
            $('.btn-qty-dec').click(function() {
                var input = $(this).closest('.input-group').find('.input-qty');
                var val = parseInt(input.val()) || 1;
                if (val > 1) {
                    input.val(val - 1);
                    $(this).closest('form').submit();
                }
            });

            // Increase Qty
            $('.btn-qty-inc').click(function() {
                var input = $(this).closest('.input-group').find('.input-qty');
                var val = parseInt(input.val()) || 1;
                input.val(val + 1);
                $(this).closest('form').submit();
            });

            // Auto-Submit on manually editing Qty and pressing Enter/leaving field
            $('.input-qty').change(function() {
                var val = parseInt($(this).val()) || 1;
                if(val < 1) $(this).val(1);
                $(this).closest('form').submit();
            });

            // Auto-Save Note on blur (focus out)
            $('.note-input').blur(function() {
                var paketId = $(this).data('id');
                var text = $(this).val();

                $.ajax({
                    url: '@Url.Action("UpdateCatatan")',
                    type: 'POST',
                    data: {
                        id: paketId,
                        catatan: text
                    },
                    success: function(response) {
                        console.log('Catatan berhasil diperbarui.');
                    },
                    error: function() {
                        console.error('Gagal memperbarui catatan.');
                    }
                });
            });
        });
    </script>
}
