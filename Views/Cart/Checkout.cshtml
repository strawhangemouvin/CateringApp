@model CateringApp.Models.ViewModel.CheckoutViewModel
@{
    ViewData["Title"] = "Detail Pengiriman";
    var cart = ViewBag.Cart as List<CateringApp.Models.ViewModel.CartItem> ?? new List<CateringApp.Models.ViewModel.CartItem>();
    decimal grandTotal = cart.Sum(item => item.Subtotal);
}

<div class="container py-5">
    <!-- Step Indicator -->
    <div class="row mb-5 justify-content-center">
        <div class="col-md-10 text-center">
            <div class="d-flex justify-content-between position-relative" style="max-width: 600px; margin: 0 auto;">
                <div class="position-absolute" style="top: 20px; left: 10%; right: 10%; height: 4px; background-color: #e9ecef; z-index: 1;">
                    <div style="width: 50%; height: 100%; background-color: #28a745;"></div>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow" style="width: 45px; height: 45px; font-weight: bold;"><i class="fas fa-check"></i></div>
                    <span class="font-weight-bold text-success" style="font-size: 0.85rem;">Keranjang</span>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-2 shadow" style="width: 45px; height: 45px; font-weight: bold;">2</div>
                    <span class="font-weight-bold text-dark" style="font-size: 0.85rem;">Buat Pesanan</span>
                </div>
                <div class="text-center position-relative" style="z-index: 2; width: 100px;">
                    <div class="rounded-circle bg-white text-muted border border-secondary d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 45px; height: 45px; font-weight: bold;">3</div>
                    <span class="text-muted" style="font-size: 0.85rem;">Pembayaran</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Shipping Details Form -->
        <div class="col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-header bg-white border-0 py-3">
                    <h4 class="font-weight-bold text-dark mb-0"><i class="fas fa-truck text-success mr-2"></i> Informasi Pengiriman</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Checkout" method="post">
                        <div class="form-group mb-4">
                            <label asp-for="TanggalPengiriman" class="font-weight-bold text-dark">Tanggal Pengiriman</label>
                            <input asp-for="TanggalPengiriman" class="form-control form-control-lg" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" style="border-radius: 8px;" />
                            <span asp-validation-for="TanggalPengiriman" class="text-danger small font-weight-bold"></span>
                            <small class="form-text text-muted">Pesanan dikirim minimal H+1 dari hari ini agar dapur kami dapat mempersiapkannya secara optimal.</small>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="AlamatPengiriman" class="font-weight-bold text-dark">Alamat Pengiriman Lengkap</label>
                            <textarea asp-for="AlamatPengiriman" class="form-control" rows="4" placeholder="Masukkan alamat lengkap pengiriman, beserta patokan jika ada..." style="border-radius: 8px; resize: none;"></textarea>
                            <span asp-validation-for="AlamatPengiriman" class="text-danger small font-weight-bold"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg btn-block py-3 font-weight-bold shadow rounded-lg" style="letter-spacing: 0.5px;">
                            <i class="fas fa-check-circle mr-2"></i> Buat Pesanan Sekarang
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Order Summary side panel -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-lg bg-white mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="font-weight-bold text-dark mb-0">Rincian Belanja</h5>
                </div>
                <div class="card-body p-0">
                    <div class="px-3" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var item in cart)
                        {
                            <div class="d-flex align-items-center py-3 border-bottom">
                                <img src="@item.Gambar" class="rounded shadow-sm mr-3" style="width: 55px; height: 55px; object-fit: cover;" alt="@item.NamaPaket" />
                                <div class="flex-grow-1">
                                    <h6 class="font-weight-bold text-dark mb-0" style="font-size: 0.9rem;">@item.NamaPaket</h6>
                                    <small class="text-secondary font-weight-bold">@item.Jumlah Porsi x Rp @item.Harga.ToString("N0")</small>
                                    @if (!string.IsNullOrEmpty(item.Catatan))
                                    {
                                        <small class="text-muted d-block text-truncate" style="font-size: 0.75rem; max-width: 250px;"><i class="fas fa-comment-dots mr-1"></i> @item.Catatan</small>
                                    }
                                </div>
                                <span class="font-weight-bold text-dark text-right" style="font-size: 0.9rem; min-width: 100px;">Rp @item.Subtotal.ToString("N0")</span>
                            </div>
                        }
                    </div>
                    <div class="p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Subtotal</span>
                            <span class="font-weight-bold text-dark">Rp @grandTotal.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Biaya Kirim</span>
                            <span class="font-weight-bold text-success">Gratis</span>
                        </div>
                        <hr class="my-3" style="border-top: 1px dashed #e9ecef;" />
                        <div class="d-flex justify-content-between">
                            <h6 class="font-weight-bold text-dark mb-0">Grand Total</h6>
                            <h5 class="font-weight-bold text-success mb-0">Rp @grandTotal.ToString("N0")</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.Action("Index")" class="text-secondary font-weight-bold" style="text-decoration: none;"><i class="fas fa-arrow-left mr-2"></i> Kembali ke Keranjang</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
