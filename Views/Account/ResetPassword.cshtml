@model CateringApp.Models.ViewModel.ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Reset Password - Catering App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <h3><b>Catering</b>System</h3>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Masukkan password baru Anda.</p>
                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    
                    <input type="hidden" asp-for="Email" />

                    <div class="form-group mb-3">
                        <label class="text-sm">Email User:</label>
                        <input class="form-control" value="@Model.Email" readonly disabled />
                    </div>

                    <div class="input-group mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password Baru" />
                        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-lock"></span></div></div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger text-sm d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Konfirmasi Password Baru" />
                        <div class="input-group-append"><div class="input-group-text"><span class="fas fa-lock"></span></div></div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger text-sm d-block mb-2"></span>

                    <button type="submit" class="btn btn-primary btn-block">Simpan Password Baru</button>
                </form>
                <p class="mt-3 mb-0 text-center">
                    <a href="@Url.Action("Login", "Account")">Kembali ke halaman Login</a>
                </p>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
