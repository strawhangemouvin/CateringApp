@model CateringApp.Models.ViewModel.RegisterViewModel
@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Daftar Akun Baru - CateringApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-lg" style="background-color: #ffffff;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="text-danger mb-2"><i class="fas fa-user-plus fa-3x"></i></div>
                        <h3 class="font-weight-bold text-dark">Daftar Akun Baru</h3>
                        <p class="text-muted">Buat akun untuk mulai memesan catering premium</p>
                    </div>
                    
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="NamaLengkap" class="font-weight-bold">Nama Lengkap</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-id-card text-muted"></i></span>
                                        </div>
                                        <input asp-for="NamaLengkap" class="form-control border-left-0 bg-light" placeholder="Nama Lengkap" />
                                    </div>
                                    <span asp-validation-for="NamaLengkap" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Username" class="font-weight-bold">Username</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-user text-muted"></i></span>
                                        </div>
                                        <input asp-for="Username" class="form-control border-left-0 bg-light" placeholder="Username" />
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="font-weight-bold">Email</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-envelope text-muted"></i></span>
                                        </div>
                                        <input asp-for="Email" type="email" class="form-control border-left-0 bg-light" placeholder="Email" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="NomorTelepon" class="font-weight-bold">Nomor Telepon</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-phone text-muted"></i></span>
                                        </div>
                                        <input asp-for="NomorTelepon" class="form-control border-left-0 bg-light" placeholder="Nomor Telepon" />
                                    </div>
                                    <span asp-validation-for="NomorTelepon" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Alamat" class="font-weight-bold">Alamat Lengkap</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                                </div>
                                <textarea asp-for="Alamat" class="form-control border-left-0 bg-light" placeholder="Alamat Lengkap Anda" rows="2"></textarea>
                            </div>
                            <span asp-validation-for="Alamat" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Password" class="font-weight-bold">Password</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-lock text-muted"></i></span>
                                        </div>
                                        <input asp-for="Password" type="password" class="form-control border-left-0 bg-light" placeholder="Password" />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="ConfirmPassword" class="font-weight-bold">Konfirmasi Password</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-lock text-muted"></i></span>
                                        </div>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control border-left-0 bg-light" placeholder="Konfirmasi Password" />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brand-primary btn-block py-2 mb-3">Daftar Akun</button>
                    </form>
                    
                    <div class="text-center mt-4">
                        <p class="mb-0 small text-muted">
                            Sudah punya akun? <a href="@Url.Action("Login", "Account")" class="text-danger font-weight-bold">Masuk di sini</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
