@model CateringApp.Models.ViewModel.CustomerDashboardViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string userFullName = session?.GetString("Nama") ?? "Pelanggan";
    ViewData["Title"] = "Dashboard Pelanggan";
}

<!-- Welcome Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-gradient-primary border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;">
            <div class="card-body p-4 text-white">
                <div class="d-flex align-items-center justify-content-between flex-wrap">
                    <div class="mb-2 mb-md-0">
                        <h4 class="font-weight-bold mb-1" style="font-family: 'Outfit', sans-serif;">Selamat Datang Kembali, @userFullName!</h4>
                        <p class="mb-0 text-white-50">Kelola pesanan katering Anda, lacak pengiriman, dan lakukan transaksi dengan mudah.</p>
                    </div>
                    <div>
                        <a href="@Url.Action("Katalog", "Pesanan")" class="btn btn-light text-primary font-weight-bold px-4 py-2" style="border-radius: 8px;">
                            <i class="fas fa-utensils mr-2"></i> Mulai Pesan Katering
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row">
    <!-- Stat 1: Total Orders -->
    <div class="col-lg-4 col-sm-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; transition: transform 0.2s;">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase font-weight-bold small mb-1">Total Pesanan Saya</h6>
                    <h3 class="mb-0 font-weight-bold text-dark">@Model.TotalPesanan <span class="text-muted font-weight-normal" style="font-size: 1rem;">Transaksi</span></h3>
                </div>
                <div class="bg-primary-light p-3" style="background-color: rgba(0, 123, 255, 0.1); border-radius: 50%;">
                    <i class="fas fa-shopping-bag text-primary fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 2: Total Spent -->
    <div class="col-lg-4 col-sm-6 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; transition: transform 0.2s;">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase font-weight-bold small mb-1">Total Belanja (Selesai)</h6>
                    <h3 class="mb-0 font-weight-bold text-success">Rp @Model.TotalBelanja.ToString("N0")</h3>
                </div>
                <div class="bg-success-light p-3" style="background-color: rgba(40, 167, 69, 0.1); border-radius: 50%;">
                    <i class="fas fa-wallet text-success fa-2x"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 3: Active Orders -->
    <div class="col-lg-4 col-12 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; transition: transform 0.2s;">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase font-weight-bold small mb-1">Pesanan Aktif / Lacak</h6>
                    <h3 class="mb-0 font-weight-bold text-warning">@Model.PesananAktif <span class="text-muted font-weight-normal" style="font-size: 1rem;">Diproses</span></h3>
                </div>
                <div class="bg-warning-light p-3" style="background-color: rgba(255, 193, 7, 0.1); border-radius: 50%;">
                    <i class="fas fa-clock text-warning fa-2x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Quick Actions Panel -->
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <h5 class="card-title font-weight-bold text-dark mb-0" style="font-family: 'Outfit', sans-serif;"><i class="fas fa-compass mr-2 text-primary"></i> Akses Cepat</h5>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="d-flex flex-column gap-3">
                    <a href="@Url.Action("Katalog", "Pesanan")" class="d-flex align-items-center p-3 text-decoration-none bg-light border" style="border-radius: 8px; color: #495057; transition: background-color 0.2s; margin-bottom: 12px;">
                        <i class="fas fa-utensils text-primary fa-lg mr-3"></i>
                        <div>
                            <div class="font-weight-bold mb-0">Katalog Menu</div>
                            <small class="text-muted">Pilih paket katering lezat</small>
                        </div>
                        <i class="fas fa-chevron-right ml-auto text-muted"></i>
                    </a>
                    
                    <a href="@Url.Action("Index", "Pesanan")" class="d-flex align-items-center p-3 text-decoration-none bg-light border" style="border-radius: 8px; color: #495057; transition: background-color 0.2s; margin-bottom: 12px;">
                        <i class="fas fa-history text-success fa-lg mr-3"></i>
                        <div>
                            <div class="font-weight-bold mb-0">Riwayat Pesanan Saya</div>
                            <small class="text-muted">Cek semua pesanan Anda</small>
                        </div>
                        <i class="fas fa-chevron-right ml-auto text-muted"></i>
                    </a>

                    <a href="@Url.Action("Index", "Cart")" class="d-flex align-items-center p-3 text-decoration-none bg-light border" style="border-radius: 8px; color: #495057; transition: background-color 0.2s;">
                        <i class="fas fa-shopping-basket text-info fa-lg mr-3"></i>
                        <div>
                            <div class="font-weight-bold mb-0">Keranjang Belanja</div>
                            <small class="text-muted">Lanjutkan ke pembayaran</small>
                        </div>
                        <i class="fas fa-chevron-right ml-auto text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="col-md-8 mb-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between pt-4 px-4 pb-0">
                <h5 class="card-title font-weight-bold text-dark mb-0" style="font-family: 'Outfit', sans-serif;"><i class="fas fa-history mr-2 text-success"></i> 5 Pesanan Terbaru</h5>
                <a href="@Url.Action("Index", "Pesanan")" class="btn btn-link text-primary font-weight-bold p-0">Lihat Semua</a>
            </div>
            <div class="card-body p-0 mt-3">
                <div class="table-responsive">
                    <table class="table table-hover table-valign-middle mb-0" style="border-collapse: collapse;">
                        <thead>
                            <tr class="bg-light">
                                <th class="pl-4" style="border-top: none;">No. Pesanan</th>
                                <th style="border-top: none;">Tgl Pesan</th>
                                <th style="border-top: none;">Total Bayar</th>
                                <th style="border-top: none;">Status</th>
                                <th class="pr-4 text-center" style="border-top: none; width: 220px;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PesananTerbaru != null && Model.PesananTerbaru.Any())
                            {
                                foreach (var item in Model.PesananTerbaru)
                                {
                                    bool isPendingPayment = item.StatusPesanan == "Pending" && (item.Pembayaran == null || item.Pembayaran.StatusVerifikasi == "Belum Bayar");
                                    <tr>
                                        <td class="pl-4 font-weight-bold text-primary">@item.NomorPesanan</td>
                                        <td>@item.TanggalPesan.ToString("dd MMM yyyy")</td>
                                        <td class="font-weight-bold">Rp @item.TotalBayar.ToString("N0")</td>
                                        <td>
                                            <span class="badge px-3 py-2" style="border-radius: 20px; font-size: 85%; 
                                                background-color: @(item.StatusPesanan == "Selesai" ? "rgba(40, 167, 69, 0.1)" : (item.StatusPesanan == "Diproses" ? "rgba(23, 162, 184, 0.1)" : (item.StatusPesanan == "Dikirim" ? "rgba(0, 123, 255, 0.1)" : "rgba(255, 193, 7, 0.1)")));
                                                color: @(item.StatusPesanan == "Selesai" ? "#28a745" : (item.StatusPesanan == "Diproses" ? "#17a2b8" : (item.StatusPesanan == "Dikirim" ? "#007bff" : "#fd7e14")));">
                                                @item.StatusPesanan
                                            </span>
                                        </td>
                                        <td class="pr-4 text-center">
                                            <div class="d-flex align-items-center justify-content-center" style="gap: 5px;">
                                                <a href="@Url.Action("Details", "Pesanan", new { id = item.PesananId })" class="btn btn-outline-primary btn-sm px-3" style="border-radius: 6px;">
                                                    <i class="fas fa-eye mr-1"></i> Rincian
                                                </a>
                                                @if (isPendingPayment)
                                                {
                                                    <a href="@Url.Action("Bayar", "Pesanan", new { id = item.PesananId })" class="btn btn-warning btn-sm px-3 font-weight-bold" style="border-radius: 6px; color: #212529;">
                                                        <i class="fas fa-upload mr-1"></i> Bayar
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fas fa-utensils fa-3x mb-3 text-black-50"></i>
                                        <p class="mb-0">Anda belum melakukan pesanan katering apa pun.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
