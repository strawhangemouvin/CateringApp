@model CateringApp.Models.ViewModel.PemesananViewModel
@{
    ViewData["Title"] = "Pesan Menu Baru";
}

<div class="row">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Form Pemesanan Catering</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="PaketId">Pilih Paket Menu</label>
                        <select asp-for="PaketId" class="form-control" asp-items="ViewBag.PaketId">
                            <option value="">-- Pilih Paket --</option>
                        </select>
                        <span asp-validation-for="PaketId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="JumlahPorsi">Jumlah Porsi</label>
                        <input asp-for="JumlahPorsi" type="number" class="form-control" placeholder="Contoh: 50" min="1" />
                        <span asp-validation-for="JumlahPorsi" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="TanggalPengiriman">Tanggal Pengiriman</label>
                        <input asp-for="TanggalPengiriman" type="date" class="form-control" value="@Model?.TanggalPengiriman.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="TanggalPengiriman" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AlamatPengiriman">Alamat Pengiriman Lengkap</label>
                        <textarea asp-for="AlamatPengiriman" class="form-control" rows="3" placeholder="Masukkan alamat lengkap tujuan pengiriman"></textarea>
                        <span asp-validation-for="AlamatPengiriman" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Catatan">Catatan Khusus (Opsional)</label>
                        <textarea asp-for="Catatan" class="form-control" rows="2" placeholder="Contoh: Sambal dipisah, lauk tidak pedas"></textarea>
                        <span asp-validation-for="Catatan" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Lanjutkan ke Pembayaran</button>
                    <a href="@Url.Action("Index")" class="btn btn-default">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>
