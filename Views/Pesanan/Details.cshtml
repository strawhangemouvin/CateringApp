@model CateringApp.Models.Entity.Pesanan
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Detail Pesanan #" + Model.NomorPesanan;
    var session = HttpContextAccessor.HttpContext?.Session;
    string? role = session?.GetString("Role");

    bool isPaymentVerified = Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Valid";
    int stepProgress = Model.StatusPesanan switch
    {
        "Selesai" => 4,
        "Dikirim" => 3,
        "Diproses" => 2,
        _ => (isPaymentVerified ? 1 : 0)
    };
    bool isCancelled = Model.StatusPesanan == "Dibatalkan" || Model.StatusPesanan == "Batal";
    bool isOverdue = Model.StatusPesanan != "Selesai" && !isCancelled && Model.TanggalPengiriman.Date < DateTime.Today;
}

<!-- Overdue Warning Banner if Past Delivery Date -->
@if (isOverdue)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle fa-2x mr-3"></i>
            <div>
                <h5 class="mb-1 font-weight-bold">Perhatian: Tanggal Pengiriman Telah Terlewat!</h5>
                <span>Jadwal pengiriman pesanan ini adalah <strong>@Model.TanggalPengiriman.ToString("dd MMMM yyyy")</strong>, namun pesanan belum diselesaikan. Segera tindak lanjuti operasional atau konfirmasi ke pelanggan.</span>
            </div>
        </div>
    </div>
}

<!-- Order Tracking Timeline Tracker Card -->
<div class="card card-outline card-success shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-route text-success mr-2"></i> Pelacakan Progres Pesanan</h5>
    </div>
    <div class="card-body py-4">
        @if (isCancelled)
        {
            <div class="alert alert-secondary text-center mb-0">
                <i class="fas fa-ban text-danger fa-2x mb-2 d-block"></i>
                <h5 class="font-weight-bold text-danger mb-1">Pesanan Dibatalkan</h5>
                <span class="text-muted">Pesanan ini telah dibatalkan. Hubungi admin/layanan pelanggan jika memerlukan bantuan refund dana.</span>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between position-relative mx-auto" style="max-width: 750px;">
                <div class="position-absolute" style="top: 20px; left: 8%; right: 8%; height: 4px; background-color: #e9ecef; z-index: 1;">
                    <div style="width: @(stepProgress * 33.33)%; height: 100%; background-color: #28a745; transition: width 0.4s ease;"></div>
                </div>

                <div class="text-center position-relative" style="z-index: 2; width: 120px;">
                    <div class="rounded-circle @(stepProgress >= 0 ? "bg-success text-white" : "bg-light text-muted border") d-flex align-items-center justify-content-center mx-auto mb-2 shadow-sm" style="width: 42px; height: 42px; font-weight: bold;">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <span class="font-weight-bold @(stepProgress >= 0 ? "text-dark" : "text-muted")" style="font-size: 0.8rem;">1. Dipesan</span>
                    <small class="text-muted d-block" style="font-size: 0.7rem;">@Model.TanggalPesan.ToString("dd/MM HH:mm")</small>
                </div>

                <div class="text-center position-relative" style="z-index: 2; width: 130px;">
                    <div class="rounded-circle @(stepProgress >= 1 ? "bg-success text-white shadow-sm" : "bg-white text-muted border") d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px; font-weight: bold;">
                        <i class="fas @(stepProgress >= 1 ? "fa-check" : "fa-credit-card")"></i>
                    </div>
                    <span class="font-weight-bold @(stepProgress >= 1 ? "text-dark" : "text-muted")" style="font-size: 0.8rem;">2. Terverifikasi</span>
                    <small class="text-muted d-block" style="font-size: 0.7rem;">@(isPaymentVerified ? "Lunas" : "Menunggu Bayar")</small>
                </div>

                <div class="text-center position-relative" style="z-index: 2; width: 120px;">
                    <div class="rounded-circle @(stepProgress >= 2 ? "bg-success text-white shadow-sm" : "bg-white text-muted border") d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px; font-weight: bold;">
                        <i class="fas @(stepProgress >= 2 ? "fa-fire" : "fa-utensils")"></i>
                    </div>
                    <span class="font-weight-bold @(stepProgress >= 2 ? "text-dark" : "text-muted")" style="font-size: 0.8rem;">3. Dimasak</span>
                    <small class="text-muted d-block" style="font-size: 0.7rem;">Dapur Katering</small>
                </div>

                <div class="text-center position-relative" style="z-index: 2; width: 120px;">
                    <div class="rounded-circle @(stepProgress >= 3 ? "bg-success text-white shadow-sm" : "bg-white text-muted border") d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px; font-weight: bold;">
                        <i class="fas fa-truck"></i>
                    </div>
                    <span class="font-weight-bold @(stepProgress >= 3 ? "text-dark" : "text-muted")" style="font-size: 0.8rem;">4. Dikirim</span>
                    <small class="text-muted d-block" style="font-size: 0.7rem;">Menuju Lokasi</small>
                </div>

                <div class="text-center position-relative" style="z-index: 2; width: 120px;">
                    <div class="rounded-circle @(stepProgress >= 4 ? "bg-success text-white shadow-sm" : "bg-white text-muted border") d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 42px; height: 42px; font-weight: bold;">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <span class="font-weight-bold @(stepProgress >= 4 ? "text-success" : "text-muted")" style="font-size: 0.8rem;">5. Selesai</span>
                    <small class="text-muted d-block" style="font-size: 0.7rem;">Telah Diterima</small>
                </div>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <!-- Order info -->
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">Informasi Pesanan</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 35%;">No. Pesanan</th>
                        <td class="font-weight-bold text-primary">@Model.NomorPesanan</td>
                    </tr>
                    <tr>
                        <th>Pelanggan</th>
                        <td>@Model.Pengguna?.NamaLengkap (@Model.Pengguna?.Username)</td>
                    </tr>
                    <tr>
                        <th>Tanggal Pesan</th>
                        <td>@Model.TanggalPesan.ToString("dd MMM yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <th>Tanggal Pengiriman</th>
                        <td>@Model.TanggalPengiriman.ToString("dd MMM yyyy")</td>
                    </tr>
                    <tr>
                        <th>Alamat Pengiriman</th>
                        <td>@Model.AlamatPengiriman</td>
                    </tr>
                    <tr>
                        <th>Status Pesanan</th>
                        <td>
                            <span class="badge @(Model.StatusPesanan == "Selesai" ? "badge-success" : (Model.StatusPesanan == "Diproses" ? "badge-info" : (Model.StatusPesanan == "Dikirim" ? "badge-primary" : (Model.StatusPesanan == "Dibatalkan" ? "badge-danger" : "badge-warning"))))">
                                @Model.StatusPesanan
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Total Bayar</th>
                        <td class="font-weight-bold text-lg text-success">Rp @Model.TotalBayar.ToString("N0")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Detail menu items -->
        <div class="card card-outline card-secondary">
            <div class="card-header">
                <h3 class="card-title">Menu Yang Dipesan</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-valign-middle">
                    <thead>
                        <tr>
                            <th>Paket Menu</th>
                            <th>Harga Satuan</th>
                            <th>Porsi / Qty</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.DetailPesanans)
                        {
                            <tr>
                                <td>
                                    <strong>@detail.Paket?.NamaPaket</strong>
                                    <br />
                                    <small class="text-muted">Catatan: @(detail.Catatan ?? "-")</small>
                                </td>
                                <td>Rp @detail.HargaSatuan.ToString("N0")</td>
                                <td>@detail.Jumlah porsi</td>
                                <td>Rp @detail.Subtotal.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <!-- Payment info -->
        <div class="card card-outline card-success">
            <div class="card-header">
                <h3 class="card-title">Informasi Pembayaran</h3>
            </div>
            <div class="card-body">
                @if (Model.Pembayaran != null)
                {
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 45%;">Metode</th>
                            <td>@Model.Pembayaran.MetodePembayaran</td>
                        </tr>
                        <tr>
                            <th>Jumlah Bayar</th>
                            <td>Rp @Model.Pembayaran.JumlahBayar.ToString("N0")</td>
                        </tr>
                        <tr>
                            <th>Tanggal Bayar</th>
                            <td>@Model.Pembayaran.TanggalBayar.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <th>Status Verifikasi</th>
                            <td>
                                <span class="badge @(Model.Pembayaran.StatusVerifikasi == "Valid" ? "badge-success" : (Model.Pembayaran.StatusVerifikasi == "Tidak Valid" ? "badge-danger" : "badge-warning"))">
                                    @Model.Pembayaran.StatusVerifikasi
                                </span>
                            </td>
                        </tr>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.Pembayaran.BuktiTransfer))
                    {
                        <div class="mt-3 text-center">
                            <label class="d-block text-left">Bukti Transfer:</label>
                            @if (Model.Pembayaran.BuktiTransfer.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Model.Pembayaran.BuktiTransfer" class="btn btn-default btn-block" target="_blank">
                                    <i class="fas fa-file-pdf text-danger"></i> Lihat Dokumen Bukti (PDF)
                                </a>
                            }
                            else
                            {
                                <a href="@Model.Pembayaran.BuktiTransfer" target="_blank">
                                    <img src="@Model.Pembayaran.BuktiTransfer" class="img-fluid img-thumbnail" style="max-height: 250px;" alt="Bukti Transfer" />
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-exclamation-triangle"></i> Belum ada pembayaran untuk transaksi ini.
                        @if (role == "User")
                        {
                            <div class="mt-3">
                                <a href="@Url.Action("Bayar", new { id = Model.PesananId })" class="btn btn-success btn-sm btn-block">
                                    <i class="fas fa-upload"></i> Upload Bukti Bayar
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Admin actions -->
        @if (role == "Pemilik Toko" || role == "Karyawan")
        {
            <div class="card card-outline card-warning">
                <div class="card-header">
                    <h3 class="card-title text-bold">Menu Navigasi Admin</h3>
                </div>
                <div class="card-body">
                    <!-- Verification actions -->
                    @if (Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Menunggu Verifikasi")
                    {
                        <div class="mb-4">
                            <label class="d-block">Verifikasi Pembayaran:</label>
                            <div class="row">
                                <div class="col-6">
                                    <a href="@Url.Action("Verifikasi", new { id = Model.PesananId, status = "Valid" })" class="btn btn-success btn-block btn-sm">
                                        <i class="fas fa-check"></i> Valid
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="@Url.Action("Verifikasi", new { id = Model.PesananId, status = "Tidak Valid" })" class="btn btn-danger btn-block btn-sm">
                                        <i class="fas fa-times"></i> Tidak Valid
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <div>
                        <label class="d-block">Ubah Status Pesanan:</label>
                        @{
                            bool isPaymentValid = Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Valid";
                            bool isOrderFinished = Model.StatusPesanan == "Selesai";
                            bool isOrderCancelled = Model.StatusPesanan == "Dibatalkan" || Model.StatusPesanan == "Batal";
                        }
                        @if (isOrderFinished)
                        {
                            <div class="alert alert-success py-2 px-3 text-sm mb-2">
                                <i class="fas fa-check-double mr-1"></i> <strong>Pesanan Selesai</strong>: Makanan telah diterima pelanggan. Alur pesanan telah tuntas dan status tidak dapat diubah lagi.
                            </div>
                        }
                        else if (Model.StatusPesanan == "Menunggu Refund")
                        {
                            <div class="alert alert-warning py-2 px-3 text-sm mb-3">
                                <i class="fas fa-clock mr-1"></i> <strong>Perlu Refund</strong>: Pelanggan telah membatalkan pesanan. Silakan transfer kembali dana sebesar <strong>Rp @Model.TotalBayar.ToString("N0")</strong> ke rekening pelanggan di bawah ini.
                            </div>
                            <div class="card card-body bg-light border p-3 mb-3">
                                <h6 class="font-weight-bold text-dark mb-2"><i class="fas fa-university mr-1 text-primary"></i> Rekening Tujuan Refund:</h6>
                                <p class="mb-1 text-sm"><strong>Bank / E-Wallet:</strong> @Model.RefundNamaBank</p>
                                <p class="mb-1 text-sm"><strong>No. Rekening:</strong> <span class="badge badge-info p-1" style="font-size: 0.9rem;">@Model.RefundNoRekening</span></p>
                                <p class="mb-2 text-sm"><strong>Atas Nama:</strong> @Model.RefundAtasNama</p>
                                <hr class="my-2" />
                                <form asp-action="KonfirmasiRefund" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pesananId" value="@Model.PesananId" />
                                    <div class="form-group mb-2">
                                        <label class="text-xs font-weight-bold">Upload Bukti Transfer Balik (Refund):</label>
                                        <input type="file" name="fileBuktiTf" class="form-control-file text-sm" required accept=".jpg,.jpeg,.png,.webp,.pdf" />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm btn-block font-weight-bold" onclick="return confirm('Apakah Anda yakin telah mentransfer dana ke rekening pelanggan dan ingin menyelesaikan refund?');">
                                        <i class="fas fa-check-circle mr-1"></i> Konfirmasi Selesai Refund
                                    </button>
                                </form>
                            </div>
                        }
                        else if (Model.StatusPesanan == "Refund Selesai")
                        {
                            <div class="alert alert-info py-2 px-3 text-sm mb-2">
                                <i class="fas fa-hand-holding-usd mr-1"></i> <strong>Refund Selesai</strong>: Dana telah berhasil ditransfer kembali ke rekening pelanggan.
                            </div>
                        }
                        else if (isOrderCancelled)
                        {
                            <div class="alert alert-danger py-2 px-3 text-sm mb-2">
                                <i class="fas fa-times-circle mr-1"></i> <strong>Pesanan Dibatalkan</strong>: Status pesanan sudah dibatalkan dan tidak dapat diproses lagi.
                            </div>
                        }
                        else if (!isPaymentValid)
                        {
                            <div class="alert alert-warning py-1 px-2 text-xs mb-2">
                                <i class="fas fa-exclamation-triangle"></i> Pembayaran belum diverifikasi (Valid). Tombol proses & selesai dikunci.
                            </div>
                        }

                        @if (!isOrderFinished && !isOrderCancelled && Model.StatusPesanan != "Menunggu Refund" && Model.StatusPesanan != "Refund Selesai")
                        {
                            <div class="btn-group-vertical w-100">
                                @if (Model.StatusPesanan == "Pending")
                                {
                                    <button class="btn btn-secondary btn-sm text-left mb-1 disabled" disabled>
                                        <i class="fas fa-clock"></i> Status Saat Ini: Pending
                                    </button>
                                }

                                <a href="@(isPaymentValid && Model.StatusPesanan == "Pending" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Diproses" }) : "#")" 
                                   class="btn btn-info btn-sm text-left mb-1 @(Model.StatusPesanan == "Diproses" ? "active" : "") @(isPaymentValid && Model.StatusPesanan == "Pending" ? "" : "disabled")">
                                    <i class="fas fa-spinner"></i> 1. Mulai Diproses (Masak)
                                </a>

                                <a href="@(isPaymentValid && Model.StatusPesanan == "Diproses" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Dikirim" }) : "#")" 
                                   class="btn btn-primary btn-sm text-left mb-1 @(Model.StatusPesanan == "Dikirim" ? "active" : "") @(isPaymentValid && Model.StatusPesanan == "Diproses" ? "" : "disabled")">
                                    <i class="fas fa-truck"></i> 2. Kirim Pesanan (Kurir)
                                </a>

                                <a href="@(isPaymentValid && Model.StatusPesanan == "Dikirim" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Selesai" }) : "#")" 
                                   class="btn btn-success btn-sm text-left mb-1 @(isPaymentValid && Model.StatusPesanan == "Dikirim" ? "" : "disabled")">
                                    <i class="fas fa-check-circle"></i> 3. Tandai Selesai (Diterima)
                                </a>

                                <a href="@Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Dibatalkan" })" 
                                   class="btn btn-outline-danger btn-sm text-left mt-2" 
                                   onclick="return confirm('Apakah Anda yakin ingin membatalkan pesanan ini?');">
                                    <i class="fas fa-times-circle"></i> Batalkan Pesanan
                                </a>
                            </div>
                        }
                </div>
            </div>
        }

        <!-- Customer Refund & Cancellation Card -->
        @if (role == "User")
        {
            @if (Model.StatusPesanan == "Menunggu Refund")
            {
                <div class="card card-outline card-warning shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-spinner fa-spin text-warning mr-2"></i> Pengembalian Dana Diproses</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-secondary mb-2">
                            Pesanan Anda telah dibatalkan. Dana sebesar <strong class="text-success font-weight-bold">Rp @Model.TotalBayar.ToString("N0")</strong> sedang diproses untuk ditransfer kembali ke:
                        </p>
                        <div class="p-3 bg-light rounded border mb-2">
                            <div><strong>Bank / E-Wallet:</strong> @Model.RefundNamaBank</div>
                            <div><strong>Nomor Rekening:</strong> @Model.RefundNoRekening</div>
                            <div><strong>Atas Nama:</strong> @Model.RefundAtasNama</div>
                        </div>
                        <small class="text-muted"><i class="fas fa-info-circle mr-1"></i> Proses pengembalian dana memakan waktu maksimal 1x24 jam kerja.</small>
                    </div>
                </div>
            }
            else if (Model.StatusPesanan == "Refund Selesai")
            {
                <div class="card card-outline card-success shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title font-weight-bold text-success mb-0"><i class="fas fa-check-circle mr-2"></i> Pengembalian Dana Telah Selesai</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-secondary mb-3">
                            Dana sebesar <strong class="text-success font-weight-bold">Rp @Model.TotalBayar.ToString("N0")</strong> telah berhasil ditransfer kembali ke rekening <strong>@Model.RefundNamaBank - @Model.RefundNoRekening (a.n @Model.RefundAtasNama)</strong>.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.RefundBuktiTf))
                        {
                            <a href="@Model.RefundBuktiTf" target="_blank" class="btn btn-success btn-block py-2 font-weight-bold shadow-sm">
                                <i class="fas fa-receipt mr-1"></i> Lihat Bukti Transfer Balik Admin
                            </a>
                        }
                    </div>
                </div>
            }
            else if (Model.StatusPesanan != "Selesai" && Model.StatusPesanan != "Dibatalkan")
            {
                <div class="card border shadow-sm">
                    <div class="card-body">
                        @if (isPaymentValid || (Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Menunggu Verifikasi"))
                        {
                            <button type="button" class="btn btn-outline-danger btn-block py-2 font-weight-bold" data-toggle="modal" data-target="#modalRefund">
                                <i class="fas fa-times-circle mr-1"></i> Batalkan Pesanan & Ajukan Refund
                            </button>
                        }
                        else if (Model.StatusPesanan == "Pending")
                        {
                            <a href="@Url.Action("Delete", new { id = Model.PesananId })" class="btn btn-outline-danger btn-block py-2 font-weight-bold" onclick="return confirm('Apakah Anda yakin ingin membatalkan pesanan ini?');">
                                <i class="fas fa-trash-alt mr-1"></i> Batalkan Pesanan
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal Form Pengajuan Refund untuk Pelanggan -->
<div class="modal fade" id="modalRefund" tabindex="-1" role="dialog" aria-labelledby="modalRefundLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-bold" id="modalRefundLabel"><i class="fas fa-hand-holding-usd mr-2"></i> Form Pengajuan Pengembalian Dana</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="AjukanRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pesananId" value="@Model.PesananId" />
                <div class="modal-body py-4">
                    <p class="text-secondary small mb-3">
                        Karena Anda telah melakukan pembayaran untuk pesanan ini, silakan masukkan informasi rekening atau e-wallet Anda untuk menerima pengembalian dana penuh sebesar <strong>Rp @Model.TotalBayar.ToString("N0")</strong>.
                    </p>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Nama Bank / E-Wallet <span class="text-danger">*</span></label>
                        <input type="text" name="namaBank" class="form-control" placeholder="Contoh: BCA, Mandiri, BRI, GoPay, OVO, Dana" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Nomor Rekening / No. HP E-Wallet <span class="text-danger">*</span></label>
                        <input type="text" name="noRekening" class="form-control" placeholder="Masukkan nomor rekening atau nomor HP akun" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark">Nama Pemilik Rekening (Sesuai Buku Tabungan/Akun) <span class="text-danger">*</span></label>
                        <input type="text" name="atasNama" class="form-control" placeholder="Contoh: Budi Pratama" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-danger px-4 font-weight-bold" onclick="return confirm('Apakah data rekening Anda sudah benar? Pesanan akan dibatalkan dan diajukan ke admin.');">
                        <i class="fas fa-paper-plane mr-1"></i> Konfirmasi Pembatalan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
