@{
    ViewData["Title"] = "404 - Halaman Tidak Ditemukan";
}
<div class="error-page mt-5">
    <h2 class="headline text-warning">404</h2>
    <div class="error-content">
        <h3><i class="fas fa-exclamation-triangle text-warning"></i> Halaman Tidak Ditemukan.</h3>
        <p>
            Halaman yang Anda cari tidak dapat ditemukan atau telah dihapus.
            Kembali ke <a href="@Url.Action("Index", "Pesanan")">Daftar Pesanan</a> atau hubungi layanan pelanggan.
        </p>
    </div>
</div>
