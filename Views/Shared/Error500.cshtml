@{
    ViewData["Title"] = "500 - Kesalahan Server Internal";
}
<div class="error-page mt-5">
    <h2 class="headline text-danger">500</h2>
    <div class="error-content">
        <h3><i class="fas fa-exclamation-circle text-danger"></i> Kesalahan Server Internal.</h3>
        <p>
            Terjadi masalah di server kami saat memproses permintaan Anda. Kami akan segera memperbaikinya.
            Silakan coba memuat ulang halaman ini nanti, atau kembali ke <a href="@Url.Action("Index", "Pesanan")">Daftar Pesanan</a>.
        </p>
    </div>
</div>
