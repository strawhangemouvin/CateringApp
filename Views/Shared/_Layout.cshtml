@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string? role = session?.GetString("Role");
    string? nama = session?.GetString("Nama") ?? "Guest";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Catering System</title>
    <!-- Google Fonts & Bootstrap/FontAwesome CDN -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        body {
            font-family: 'Outfit', sans-serif !important;
            background-color: #fcfbf7 !important;
            color: #2c2520 !important;
        }
        .content-wrapper {
            background-color: #fcfbf7 !important;
        }
        .main-sidebar {
            background-color: #2c2520 !important;
        }
        .main-header {
            background-color: #ffffff !important;
            border-bottom: 1px solid rgba(0,0,0,0.06) !important;
        }
        .brand-link {
            background-color: #2c2520 !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
            color: #d9534f !important;
            font-weight: 700 !important;
        }
        .nav-sidebar .nav-link.active {
            background-color: #d9534f !important;
            color: #ffffff !important;
        }
        .btn-primary {
            background-color: #d9534f !important;
            border-color: #d9534f !important;
            color: #ffffff !important;
        }
        .btn-primary:hover {
            background-color: #c9302c !important;
            border-color: #c9302c !important;
        }
        .card-primary.card-outline {
            border-top: 3px solid #d9534f !important;
        }
        .card-info.card-outline {
            border-top: 3px solid #5bc0de !important;
        }
        .card-warning.card-outline {
            border-top: 3px solid #f0ad4e !important;
        }
        .card-success.card-outline {
            border-top: 3px solid #28a745 !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a></li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a class="nav-link text-danger" href="@Url.Action("Logout", "Account")" onclick="return confirm('Apakah Anda yakin ingin logout?');"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="#" class="brand-link text-center">
                <span class="brand-text font-weight-light font-weight-bold">CATERING APP</span>
            </a>
            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="info text-white">
                        <p class="d-block mb-0">@nama</p>
                        <small class="badge badge-success">@role</small>
                    </div>
                </div>
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">

                        @if (role == "Pemilik Toko" || role == "Karyawan")
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Dashboard")" class="nav-link">
                                    <i class="nav-icon fas fa-tachometer-alt"></i><p>Dashboard @(role == "Pemilik Toko" ? "Owner" : "Operasional")</p>
                                </a>
                            </li>
                        }

                        @if (role == "Pemilik Toko")
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "KategoriMenu")" class="nav-link">
                                    <i class="nav-icon fas fa-list"></i><p>Kelola Kategori Menu</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Pengguna")" class="nav-link">
                                    <i class="nav-icon fas fa-users-cog"></i><p>Kelola Pengguna</p>
                                </a>
                            </li>
                        }

                        @if (role == "Pemilik Toko" || role == "Karyawan")
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "PaketMenu")" class="nav-link">
                                    <i class="nav-icon fas fa-utensils"></i><p>Kelola Paket Menu</p>
                                </a>
                            </li>
                        }

                        @if (role == "User")
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Katalog", "Pesanan")" class="nav-link">
                                    <i class="nav-icon fas fa-book-open"></i><p>Katalog Menu</p>
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Pesanan")" class="nav-link">
                                <i class="nav-icon fas fa-shopping-cart"></i><p>@(role == "Pemilik Toko" || role == "Karyawan" ? "Kelola Semua Pesanan" : "Pesanan Saya")</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper p-3">
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": false,
                "positionClass": "toast-top-right",
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000"
            };
            
            @if (TempData["Success"] != null)
            {
                <text>toastr.success("@TempData["Success"]");</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>toastr.error("@TempData["Error"]");</text>
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>