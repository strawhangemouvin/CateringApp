@model IEnumerable<CateringApp.Models.Entity.KategoriMenu>
@{
    ViewData["Title"] = "Kelola Kategori Menu";
}

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title">Daftar Kategori Menu</h3>
        <div class="card-tools">
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Tambah Kategori
            </a>
        </div>
    </div>
    
    <div class="card-body">
        <!-- Search, Sort & Paging Controls -->
        <form method="get" class="row mb-3 align-items-center">
            <div class="col-md-4 mb-2">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Cari kategori..." value="@ViewBag.Search" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-default"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3 mb-2">
                <select name="sort" class="form-control" onchange="this.form.submit()">
                    <option value="terbaru" selected="@(ViewBag.Sort == "terbaru")">Terbaru</option>
                    <option value="terlama" selected="@(ViewBag.Sort == "terlama")">Terlama</option>
                    <option value="A-Z" selected="@(ViewBag.Sort == "A-Z")">Nama A-Z</option>
                    <option value="Z-A" selected="@(ViewBag.Sort == "Z-A")">Nama Z-A</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="size" class="form-control" onchange="this.form.submit()">
                    <option value="5" selected="@(ViewBag.PageSize == 5)">5 per hal</option>
                    <option value="10" selected="@(ViewBag.PageSize == 10)">10 per hal</option>
                    <option value="20" selected="@(ViewBag.PageSize == 20)">20 per hal</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <a href="@Url.Action("Index")" class="btn btn-default w-100" title="Reset filter pencarian">
                    <i class="fas fa-undo mr-1"></i> Reset
                </a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover table-bordered table-striped">
                <thead>
                    <tr>
                        <th>ID Kategori</th>
                        <th>Nama Kategori</th>
                        <th>Deskripsi</th>
                        <th>Dibuat Pada</th>
                        <th class="text-center" style="width: 200px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.KategoriId</td>
                                <td>@item.NamaKategori</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.Deskripsi">
                                        @item.Deskripsi
                                    </div>
                                </td>
                                <td>@(item.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                                <td class="text-center" style="white-space: nowrap;">
                                    <a href="@Url.Action("Details", new { id = item.KategoriId })" class="btn btn-info btn-xs"><i class="fas fa-eye"></i> Detail</a>
                                    <a href="@Url.Action("Edit", new { id = item.KategoriId })" class="btn btn-warning btn-xs"><i class="fas fa-edit"></i> Ubah</a>
                                    <a href="@Url.Action("Delete", new { id = item.KategoriId })" class="btn btn-danger btn-xs" onclick="return confirm('Hapus kategori ini?');"><i class="fas fa-trash"></i> Hapus</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">Tidak ada data ditemukan.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
            <div>
                Menampilkan @(((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1) s.d. @Math.Min((int)ViewBag.CurrentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalRecords) dari @ViewBag.TotalRecords kategori
            </div>
            
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, sort = ViewBag.Sort, page = ViewBag.CurrentPage - 1, size = ViewBag.PageSize })">Sebelumnya</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, sort = ViewBag.Sort, page = i, size = ViewBag.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, sort = ViewBag.Sort, page = ViewBag.CurrentPage + 1, size = ViewBag.PageSize })">Selanjutnya</a>
                    </li>
                </ul>
            </nav>
        </div>

    </div>
</div>
