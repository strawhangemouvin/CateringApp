@model CateringApp.Models.ViewModel.CustomerDashboardViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string userFullName = session?.GetString("Nama") ?? "Pelanggan";
    ViewData["Title"] = "Dasbor Pelanggan";
}

<!-- Modern Greeting Banner -->
<div class="card border-0 mb-4 overflow-hidden shadow-sm" style="border-radius: var(--radius-xl); background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
    <div class="card-body p-4 p-md-5 text-white">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge badge-modern mb-2" style="background: rgba(230, 57, 70, 0.25); color: #ff8a95; border: 1px solid rgba(230, 57, 70, 0.35);">
                    <i class="fas fa-hand-sparkles mr-1"></i> Selamat Datang di Portal Katering
                </span>
                <h3 class="font-heading font-weight-bold text-white mb-2" style="font-size: 1.85rem;">
                    Halo, @userFullName! Senang Melihat Anda Kembali.
                </h3>
                <p class="text-white-50 mb-0" style="font-size: 1.02rem; max-width: 640px;">
                    Pantau pesanan katering aktif Anda, telusuri aneka hidangan lezat khas Nusantara, dan kelola transaksi Anda dengan mudah.
                </p>
            </div>
            <div class="col-lg-4 text-lg-right mt-3 mt-lg-0">
                <a href="@Url.Action("Katalog", "Pesanan")" class="btn btn-modern-primary btn-lg shadow-lg px-4 py-3" style="border-radius: var(--radius-pill);">
                    <i class="fas fa-utensils mr-2"></i> Mulai Pesan Katering
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.PesananButuhRefund.Any())
{
    <div class="alert alert-danger border-0 shadow-sm rounded-lg mb-4" style="background-color: #fff1f2; border-left: 5px solid #e11d48 !important; border-radius: var(--radius-lg); padding: 18px 24px;">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <i class="fas fa-hand-holding-usd fa-2x text-danger mr-3"></i>
                <div>
                    <h5 class="font-weight-bold text-danger mb-0">Pemberitahuan Refund: @Model.PesananButuhRefund.Count Pesanan Dibatalkan Butuh Rekening Anda</h5>
                    <small class="text-muted">Pesanan Anda yang telah lunas telah dibatalkan. Masukkan nomor rekening/e-wallet Anda agar Pemilik Toko dapat mentransfer balik dana Anda.</small>
                </div>
            </div>
            <a href="@Url.Action("Details", "Pesanan", new { id = Model.PesananButuhRefund.First().PesananId })" class="btn btn-danger btn-sm font-weight-bold shadow-xs px-3 py-2" style="border-radius: var(--radius-md);">
                <i class="fas fa-edit mr-1"></i> Lengkapi Rekening Refund
            </a>
        </div>
    </div>
}

<!-- Modern Stat Cards -->
<div class="row g-4 mb-4">
    <!-- Stat 1: Total Orders -->
    <div class="col-lg-4 col-sm-6 mb-3 mb-lg-0">
        <div class="stat-card-modern h-100 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase text-muted font-weight-bold small" style="letter-spacing: 0.5px;">Total Pesanan Saya</span>
                <h3 class="font-heading font-weight-bold text-dark mt-1 mb-0" style="font-size: 1.8rem;">
                    @Model.TotalPesanan <span class="text-muted font-weight-normal" style="font-size: 0.95rem;">Transaksi</span>
                </h3>
            </div>
            <div class="stat-icon-wrapper" style="background: var(--primary-light); color: var(--primary);">
                <i class="fas fa-shopping-bag"></i>
            </div>
        </div>
    </div>

    <!-- Stat 2: Total Spent -->
    <div class="col-lg-4 col-sm-6 mb-3 mb-lg-0">
        <div class="stat-card-modern h-100 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase text-muted font-weight-bold small" style="letter-spacing: 0.5px;">Total Belanja Selesai</span>
                <h3 class="font-heading font-weight-bold text-success mt-1 mb-0" style="font-size: 1.8rem;">
                    Rp @Model.TotalBelanja.ToString("N0")
                </h3>
            </div>
            <div class="stat-icon-wrapper" style="background: var(--success-light); color: var(--success);">
                <i class="fas fa-wallet"></i>
            </div>
        </div>
    </div>

    <!-- Stat 3: Active Orders -->
    <div class="col-lg-4 col-12">
        <div class="stat-card-modern h-100 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase text-muted font-weight-bold small" style="letter-spacing: 0.5px;">Pesanan Aktif</span>
                <h3 class="font-heading font-weight-bold text-warning mt-1 mb-0" style="font-size: 1.8rem;">
                    @Model.PesananAktif <span class="text-muted font-weight-normal" style="font-size: 0.95rem;">Sedang Berjalan</span>
                </h3>
            </div>
            <div class="stat-icon-wrapper" style="background: var(--warning-light); color: var(--warning);">
                <i class="fas fa-clock"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Quick Actions Panel -->
    <div class="col-lg-4 mb-4">
        <div class="card-modern h-100 p-4">
            <div class="d-flex align-items-center mb-4">
                <div class="stat-icon-wrapper mr-3" style="width: 44px; height: 44px; background: var(--slate-100); color: var(--slate-800); font-size: 1.1rem;">
                    <i class="fas fa-compass text-danger"></i>
                </div>
                <div>
                    <h5 class="font-heading font-weight-bold mb-0 text-dark">Akses Cepat</h5>
                    <small class="text-muted">Navigasi fitur utama</small>
                </div>
            </div>

            <div class="d-flex flex-column" style="gap: 12px;">
                <a href="@Url.Action("Katalog", "Pesanan")" class="d-flex align-items-center p-3 text-decoration-none bg-light rounded-lg border transition-hover" style="border-radius: var(--radius-md); color: var(--slate-800);">
                    <div class="stat-icon-wrapper mr-3" style="width: 40px; height: 40px; background: var(--primary-light); color: var(--primary); font-size: 1rem;">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <div>
                        <div class="font-weight-bold mb-0" style="font-size: 0.95rem;">Katalog Menu</div>
                        <small class="text-muted">Pilih paket katering lezat</small>
                    </div>
                    <i class="fas fa-arrow-right ml-auto text-muted small"></i>
                </a>
                
                <a href="@Url.Action("Index", "Pesanan")" class="d-flex align-items-center p-3 text-decoration-none bg-light rounded-lg border transition-hover" style="border-radius: var(--radius-md); color: var(--slate-800);">
                    <div class="stat-icon-wrapper mr-3" style="width: 40px; height: 40px; background: var(--success-light); color: var(--success); font-size: 1rem;">
                        <i class="fas fa-receipt"></i>
                    </div>
                    <div>
                        <div class="font-weight-bold mb-0" style="font-size: 0.95rem;">Riwayat Pesanan Saya</div>
                        <small class="text-muted">Pantau seluruh status pesanan</small>
                    </div>
                    <i class="fas fa-arrow-right ml-auto text-muted small"></i>
                </a>

                <a href="@Url.Action("Index", "Cart")" class="d-flex align-items-center p-3 text-decoration-none bg-light rounded-lg border transition-hover" style="border-radius: var(--radius-md); color: var(--slate-800);">
                    <div class="stat-icon-wrapper mr-3" style="width: 40px; height: 40px; background: var(--info-light); color: var(--info); font-size: 1rem;">
                        <i class="fas fa-shopping-basket"></i>
                    </div>
                    <div>
                        <div class="font-weight-bold mb-0" style="font-size: 0.95rem;">Keranjang Belanja</div>
                        <small class="text-muted">Periksa keranjang &amp; selesaikan pesanan</small>
                    </div>
                    <i class="fas fa-arrow-right ml-auto text-muted small"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="col-lg-8 mb-4">
        <div class="card-modern h-100">
            <div class="card-header-modern d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="font-heading font-weight-bold text-dark mb-0">
                        <i class="fas fa-history text-danger mr-2"></i> Transaksi Pesanan Terbaru
                    </h5>
                    <small class="text-muted">Daftar 5 pesanan katering terakhir Anda</small>
                </div>
                <a href="@Url.Action("Index", "Pesanan")" class="btn btn-sm btn-modern-outline" style="border-radius: var(--radius-pill); font-size: 0.85rem;">
                    Lihat Semua <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted" style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px;">
                            <tr>
                                <th class="pl-4 py-3 border-top-0">No. Pesanan</th>
                                <th class="py-3 border-top-0">Tgl Pesan</th>
                                <th class="py-3 border-top-0">Total Bayar</th>
                                <th class="py-3 border-top-0">Status</th>
                                <th class="pr-4 py-3 border-top-0 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PesananTerbaru != null && Model.PesananTerbaru.Any())
                            {
                                foreach (var item in Model.PesananTerbaru)
                                {
                                    bool isPendingPayment = item.StatusPesanan == "Pending" && (item.Pembayaran == null || item.Pembayaran.StatusVerifikasi == "Belum Bayar");
                                    <tr>
                                        <td class="pl-4 font-weight-bold text-primary">
                                            @item.NomorPesanan
                                        </td>
                                        <td class="text-muted small">
                                            @item.TanggalPesan.ToString("dd MMM yyyy HH:mm")
                                        </td>
                                        <td class="font-weight-bold text-dark">
                                            Rp @item.TotalBayar.ToString("N0")
                                        </td>
                                        <td>
                                            @if (item.StatusPesanan == "Selesai")
                                            {
                                                <span class="badge-modern badge-modern-success">
                                                    <i class="fas fa-check-circle"></i> Selesai
                                                </span>
                                            }
                                            else if (item.StatusPesanan == "Dikirim")
                                            {
                                                <span class="badge-modern badge-modern-info">
                                                    <i class="fas fa-truck"></i> Dikirim
                                                </span>
                                            }
                                            else if (item.StatusPesanan == "Diproses")
                                            {
                                                <span class="badge-modern badge-modern-warning">
                                                    <i class="fas fa-fire"></i> Diproses
                                                </span>
                                            }
                                            else if (item.StatusPesanan == "Menunggu Refund")
                                            {
                                                <span class="badge-modern badge-modern-warning" style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a;">
                                                    <i class="fas fa-hand-holding-usd"></i> Menunggu Refund
                                                </span>
                                            }
                                            else if (item.StatusPesanan == "Refund Selesai")
                                            {
                                                <span class="badge-modern badge-modern-success" style="background-color: #ecfdf5; color: #059669; border: 1px solid #a7f3d0;">
                                                    <i class="fas fa-undo"></i> Refund Selesai
                                                </span>
                                            }
                                            else if (item.StatusPesanan == "Dibatalkan" || item.StatusPesanan == "Batal")
                                            {
                                                <span class="badge-modern badge-modern-danger">
                                                    <i class="fas fa-ban"></i> Dibatalkan
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-modern badge-modern-warning">
                                                    <i class="fas fa-clock"></i> Menunggu Bayar
                                                </span>
                                            }
                                        </td>
                                        <td class="pr-4 text-center">
                                            <div class="d-flex align-items-center justify-content-center" style="gap: 6px;">
                                                <a href="@Url.Action("Details", "Pesanan", new { id = item.PesananId })" class="btn btn-sm btn-modern-outline" style="padding: 6px 14px; font-size: 0.82rem;">
                                                    <i class="fas fa-eye mr-1"></i> Rincian
                                                </a>
                                                @if (isPendingPayment)
                                                {
                                                    <a href="@Url.Action("Bayar", "Pesanan", new { id = item.PesananId })" class="btn btn-sm btn-modern-primary" style="padding: 6px 14px; font-size: 0.82rem;">
                                                        <i class="fas fa-credit-card mr-1"></i> Bayar
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <div class="p-4">
                                            <i class="fas fa-receipt fa-3x mb-3 text-secondary opacity-50"></i>
                                            <h6 class="font-weight-bold text-dark mb-1">Belum Ada Transaksi</h6>
                                            <p class="small text-muted mb-3">Anda belum memiliki riwayat pesanan katering saat ini.</p>
                                            <a href="@Url.Action("Katalog", "Pesanan")" class="btn btn-sm btn-modern-primary">
                                                <i class="fas fa-utensils mr-1"></i> Mulai Pesan Sekarang
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
