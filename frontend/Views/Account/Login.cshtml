@model CateringApp.Models.ViewModel.LoginViewModel
@{
    Layout = "~/frontend/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Masuk Sesi - Catering Mimi Saripah";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <!-- Header Selamat Datang Universal (Admin & User) -->
                    <div class="text-center mb-4">
                        <div class="text-danger mb-2"><i class="fas fa-utensils fa-3x"></i></div>
                        <h3 class="fw-bold text-dark mb-1">Selamat Datang</h3>
                        <p class="text-muted small mb-0">Masuk ke akun Catering Mimi Saripah Anda</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                        <!-- Input Username -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label small fw-bold text-dark">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-user"></i></span>
                                <input asp-for="Username" class="form-control border-start-0 bg-light" placeholder="Masukkan username" required autocomplete="username" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Input Password -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label small fw-bold text-dark mb-0">Password</label>
                                <a href="@Url.Action("ForgotPassword", "Account")" class="small text-danger fw-bold text-decoration-none">Lupa Password?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" type="password" id="loginPassword" class="form-control border-start-0 border-end-0 bg-light" placeholder="Masukkan password" required autocomplete="current-password" />
                                <button type="button" class="btn btn-light border border-start-0 text-muted" id="btnToggleLoginPass" title="Lihat/Sembunyikan password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Tombol Masuk Utama -->
                        <button type="submit" class="btn btn-brand-primary w-100 py-3 fw-bold mb-3 shadow-sm">
                            <i class="fas fa-sign-in-alt me-1"></i> Masuk
                        </button>
                    </form>

                    <!-- Belum Punya Akun -->
                    <div class="text-center mt-3">
                        <p class="small text-muted mb-0">
                            Belum punya akun? <a href="@Url.Action("Register", "Account")" class="text-danger fw-bold text-decoration-none">Daftar Akun Baru</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#btnToggleLoginPass').on('click', function () {
                let $pass = $('#loginPassword');
                let $icon = $(this).find('i');
                if ($pass.attr('type') === 'password') {
                    $pass.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $pass.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });
        });
    </script>
}