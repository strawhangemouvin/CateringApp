@model CateringApp.Models.ViewModel.ResetPasswordViewModel
@{
    Layout = "~/frontend/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Reset Password - Catering Mimi Saripah";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-lg" style="background-color: #ffffff;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="text-danger mb-2"><i class="fas fa-shield-alt fa-3x"></i></div>
                        <h3 class="font-weight-bold text-dark">Reset Password</h3>
                        <p class="text-muted small">Verifikasi kode OTP dan buat kata sandi baru untuk akun Anda.</p>
                    </div>

                    @if (TempData["OtpDemo"] != null)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3 border-0 rounded text-dark shadow-sm" style="background-color: #fff3cd;">
                            <i class="fas fa-info-circle text-warning mr-1"></i> <strong>Simulasi OTP:</strong> Kode Anda adalah <strong class="badge badge-dark font-weight-bold ml-1" style="font-size: 1rem; letter-spacing: 2px;">@TempData["OtpDemo"]</strong>
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                        <input type="hidden" asp-for="Email" />

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-muted">Email Akun</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-envelope text-muted"></i></span>
                                </div>
                                <input class="form-control border-left-0 bg-light" value="@Model.Email" readonly disabled />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="KodeOtp" class="font-weight-bold">Kode OTP (6 Digit)</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-key text-muted"></i></span>
                                </div>
                                <input asp-for="KodeOtp" class="form-control border-left-0 bg-light font-weight-bold text-center" placeholder="123456" maxlength="6" style="letter-spacing: 4px; font-size: 1.1rem;" />
                            </div>
                            <span asp-validation-for="KodeOtp" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="font-weight-bold">Password Baru</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-lock text-muted"></i></span>
                                </div>
                                <input asp-for="Password" type="password" class="form-control border-left-0 bg-light" placeholder="Minimal 6 karakter" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="font-weight-bold">Konfirmasi Password Baru</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-lock text-muted"></i></span>
                                </div>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-left-0 bg-light" placeholder="Ulangi password baru" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand-primary btn-block py-2 mb-3">
                            <i class="fas fa-check-circle mr-1"></i> Simpan Password Baru
                        </button>
                    </form>

                    <div class="d-flex justify-content-between align-items-center mt-3 small">
                        <a href="@Url.Action("ForgotPassword", "Account")" class="text-muted"><i class="fas fa-redo-alt mr-1"></i> Minta OTP Baru</a>
                        <a href="@Url.Action("Login", "Account")" class="text-danger font-weight-bold">Kembali ke Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
