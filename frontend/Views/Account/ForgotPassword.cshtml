@model CateringApp.Models.ViewModel.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_GuestLayout.cshtml";
    ViewData["Title"] = "Lupa Password - CateringApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-lg" style="background-color: #ffffff;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="text-danger mb-2"><i class="fas fa-key fa-3x"></i></div>
                        <h3 class="font-weight-bold text-dark">Lupa Password?</h3>
                        <p class="text-muted small">Masukkan email terdaftar Anda untuk menerima kode verifikasi OTP reset password.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Email" class="font-weight-bold">Email Akun</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-envelope text-muted"></i></span>
                                </div>
                                <input asp-for="Email" type="email" class="form-control border-left-0 bg-light" placeholder="contoh: user@gmail.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand-primary btn-block py-2 mb-3">
                            <i class="fas fa-paper-plane mr-1"></i> Kirim Kode OTP
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <p class="mb-0 small text-muted">
                            Ingat password Anda? <a href="@Url.Action("Login", "Account")" class="text-danger font-weight-bold">Kembali ke Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
