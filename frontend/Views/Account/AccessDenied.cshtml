@{
    ViewData["Title"] = "Akses Ditolak";
}
<div class="error-page mt-5">
    <h2 class="headline text-danger">403</h2>
    <div class="error-content">
        <h3><i class="fas fa-exclamation-triangle text-danger"></i> Akses Ditolak!</h3>
        <p>
            Anda tidak memiliki hak akses untuk membuka halaman ini.
            Silakan kembali ke <a href="@Url.Action("Index", "Pesanan")">halaman utama</a> atau hubungi administrator jika Anda merasa ini adalah kesalahan.
        </p>
    </div>
</div>
