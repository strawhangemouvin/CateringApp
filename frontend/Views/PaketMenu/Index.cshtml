@model IEnumerable<CateringApp.Models.Entity.PaketMenu>
@{
    ViewData["Title"] = "Kelola Paket Menu";
}

<div class="card card-outline card-primary">
    <div class="card-header">
        <h3 class="card-title">Daftar Paket Menu Catering</h3>
        <div class="card-tools">
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Tambah Paket Baru
            </a>
        </div>
    </div>
    
    <div class="card-body">
        <!-- Filters Form -->
        <form method="get" class="row mb-3 align-items-center">
            <div class="col-md-3 mb-2">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Cari paket..." value="@ViewBag.Search" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-default"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3 mb-2">
                <select name="kategoriId" class="form-control custom-select-scroll" onchange="this.form.submit()" asp-items="ViewBag.KategoriId">
                    <option value="">-- Semua Kategori --</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="sort" class="form-control" onchange="this.form.submit()">
                    <option value="terbaru" selected="@(ViewBag.Sort == "terbaru")">Terbaru</option>
                    <option value="terlama" selected="@(ViewBag.Sort == "terlama")">Terlama</option>
                    <option value="A-Z" selected="@(ViewBag.Sort == "A-Z")">Nama A-Z</option>
                    <option value="Z-A" selected="@(ViewBag.Sort == "Z-A")">Nama Z-A</option>
                    <option value="termurah" selected="@(ViewBag.Sort == "termurah")">Harga Termurah</option>
                    <option value="termahal" selected="@(ViewBag.Sort == "termahal")">Harga Termahal</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <select name="size" class="form-control" onchange="this.form.submit()">
                    <option value="5" selected="@(ViewBag.PageSize == 5)">5 per hal</option>
                    <option value="10" selected="@(ViewBag.PageSize == 10)">10 per hal</option>
                    <option value="20" selected="@(ViewBag.PageSize == 20)">20 per hal</option>
                </select>
            </div>

            <div class="col-md-2 mb-2">
                <a href="@Url.Action("Index")" class="btn btn-default w-100" title="Reset filter pencarian">
                    <i class="fas fa-undo mr-1"></i> Reset
                </a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover table-bordered table-striped table-valign-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;" class="text-center">ID Paket</th>
                        <th style="width: 75px;" class="text-center">Foto</th>
                        <th>Kategori</th>
                        <th>Nama Paket</th>
                        <th>Harga</th>
                        <th>Deskripsi</th>
                        <th class="text-center" style="width: 200px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string photoUrl = CateringApp.Helpers.MenuImageHelper.GetGambarUrl(item.NamaPaket, item.Gambar, item.Kategori?.NamaKategori);
                            <tr>
                                <td class="text-center font-weight-bold text-secondary">@item.PaketId</td>
                                <td class="text-center">
                                    <img src="@photoUrl" alt="@item.NamaPaket" referrerpolicy="no-referrer" class="img-thumbnail" style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px;" onerror="this.onerror=null; this.src='/images/menu_box.svg';" />
                                </td>
                                <td><span class="badge badge-info">@item.Kategori?.NamaKategori</span></td>
                                <td>@item.NamaPaket</td>
                                <td>Rp @item.Harga.ToString("N0")</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 250px;" title="@item.DeskripsiMenu">
                                        @item.DeskripsiMenu
                                    </div>
                                </td>
                                <td class="text-center" style="white-space: nowrap;">
                                    <a href="@Url.Action("Details", new { id = item.PaketId })" class="btn btn-info btn-xs"><i class="fas fa-eye"></i> Detail</a>
                                    <a href="@Url.Action("Edit", new { id = item.PaketId })" class="btn btn-warning btn-xs"><i class="fas fa-edit"></i> Ubah</a>
                                    <a href="@Url.Action("Delete", new { id = item.PaketId })" class="btn btn-danger btn-xs" onclick="return confirm('Hapus paket ini?');"><i class="fas fa-trash"></i> Hapus</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">Tidak ada paket menu ditemukan.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Pager -->
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
            <div>
                Menampilkan @(ViewBag.TotalRecords == 0 ? 0 : ((ViewBag.CurrentPage - 1) * ViewBag.PageSize) + 1) s.d. @Math.Min((int)ViewBag.CurrentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalRecords) dari @ViewBag.TotalRecords paket menu
            </div>
            
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, kategoriId = ViewBag.SelectedKategori, sort = ViewBag.Sort, page = ViewBag.CurrentPage - 1, size = ViewBag.PageSize })">Sebelumnya</a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, kategoriId = ViewBag.SelectedKategori, sort = ViewBag.Sort, page = i, size = ViewBag.PageSize })">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, kategoriId = ViewBag.SelectedKategori, sort = ViewBag.Sort, page = ViewBag.CurrentPage + 1, size = ViewBag.PageSize })">Selanjutnya</a>
                    </li>
                </ul>
            </nav>
        </div>

    </div>
</div>
