@model CateringApp.Models.Entity.Pengguna
@{
    ViewData["Title"] = "Tambah Pengguna Baru";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <div class="card-header bg-gradient-danger text-white py-3 px-4" style="background: linear-gradient(135deg, #e63946 0%, #c92a37 100%); border: none;">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 font-weight-bold">
                        <i class="fas fa-user-plus mr-2 me-2"></i> Form Tambah Pengguna Baru
                    </h5>
                    <span class="badge badge-light text-danger font-weight-bold px-3 py-1">Staf &amp; Pelanggan</span>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger rounded-3 shadow-sm mb-4 py-2 px-3 small d-flex align-items-center gap-2">
                            <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                            <div>
                                <span class="fw-bold font-weight-bold">Terdapat kesalahan validasi data:</span>
                                <ul class="mb-0 ps-3 pl-3 mt-1">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <div class="alert alert-info border-0 rounded-3 mb-4 py-2 px-3 small" style="background-color: #f0fdf4; border-left: 4px solid #10b981 !important;">
                        <i class="fas fa-info-circle text-success mr-2 me-1"></i>
                        <span class="text-dark">
                            Akun <strong>Pemilik Toko</strong> hanya ada 1 akun utama. Formulir ini digunakan untuk mendaftarkan akun <strong>Karyawan</strong> operasional atau akun <strong>Pelanggan</strong> baru.
                        </span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PeranId" class="font-weight-bold text-dark small">Peran Pengguna <span class="text-danger">*</span></label>
                        <select asp-for="PeranId" class="form-control custom-select-scroll" asp-items="ViewBag.PeranId" required>
                            <option value="">-- Pilih Peran Pengguna --</option>
                        </select>
                        <span asp-validation-for="PeranId" class="text-danger small font-weight-bold"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="NamaLengkap" class="font-weight-bold text-dark small">Nama Lengkap <span class="text-danger">*</span></label>
                        <input asp-for="NamaLengkap" class="form-control rounded-3" placeholder="Contoh: Budi Santoso" required minlength="3" maxlength="100" />
                        <span asp-validation-for="NamaLengkap" class="text-danger small font-weight-bold"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Username" class="font-weight-bold text-dark small">Username <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control rounded-3" placeholder="Contoh: budi_santoso" required minlength="3" maxlength="30" pattern="^[a-zA-Z0-9_.]+$" title="Hanya huruf, angka, titik, atau garis bawah (_)" />
                            <span asp-validation-for="Username" class="text-danger small font-weight-bold"></span>
                            <small class="form-text text-muted">Tanpa spasi, minimal 3 karakter (harus unik).</small>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="PasswordHash" class="font-weight-bold text-dark small">Password <span class="text-danger">*</span></label>
                            <input asp-for="PasswordHash" type="password" class="form-control rounded-3" placeholder="Minimal 6 karakter" required minlength="6" />
                            <span asp-validation-for="PasswordHash" class="text-danger small font-weight-bold"></span>
                            <small class="form-text text-muted">Minimal 6 karakter sandi akun.</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Email" class="font-weight-bold text-dark small">Alamat Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Contoh: budi@gmail.com" required maxlength="100" />
                            <span asp-validation-for="Email" class="text-danger small font-weight-bold"></span>
                            <small class="form-text text-muted">1 email hanya untuk 1 akun pengguna.</small>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="NomorTelepon" class="font-weight-bold text-dark small">Nomor Telepon (WhatsApp) <span class="text-danger">*</span></label>
                            <input asp-for="NomorTelepon" class="form-control rounded-3" placeholder="Contoh: 081234567890" required pattern="^(08|628|\+628)[0-9]{7,11}$" maxlength="15" title="Nomor telepon harus diawali 08, 628, atau +628 (10-13 digit angka)" oninput="this.value=this.value.replace(/[^0-9+]/g,'')" />
                            <span asp-validation-for="NomorTelepon" class="text-danger small font-weight-bold"></span>
                            <small class="form-text text-muted">Awali 08, 628, atau +628 (10-13 digit angka).</small>
                        </div>
                    </div>

                    <div class="form-group mb-2">
                        <label asp-for="Alamat" class="font-weight-bold text-dark small">Alamat Lengkap <span class="text-danger">*</span></label>
                        <textarea asp-for="Alamat" class="form-control rounded-3" rows="3" placeholder="Alamat jalan, nomor rumah, RT/RW, desa/kelurahan, kecamatan..." required minlength="5" maxlength="300"></textarea>
                        <span asp-validation-for="Alamat" class="text-danger small font-weight-bold"></span>
                    </div>
                </div>

                <div class="card-footer bg-light border-top px-3 px-sm-4 py-3 d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-3 px-sm-4 py-2 font-weight-bold">
                        <i class="fas fa-arrow-left mr-1 me-1"></i> Batal
                    </a>
                    <button type="submit" class="btn btn-brand-primary rounded-pill px-3 px-sm-4 py-2 font-weight-bold text-white shadow-sm">
                        <i class="fas fa-save mr-1 me-1"></i> Simpan Pengguna
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
