@model CateringApp.Models.Entity.Pengguna
@{
    ViewData["Title"] = "Detail Pengguna";
}

<div class="row">
    <div class="col-md-6">
        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title">Informasi Detail Pengguna</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 30%;">ID Pengguna</th>
                        <td>@Model.PenggunaId</td>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <td>@Model.Username</td>
                    </tr>
                    <tr>
                        <th>Nama Lengkap</th>
                        <td>@Model.NamaLengkap</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>
                    <tr>
                        <th>Peran Pengguna</th>
                        <td>
                             <span class="badge @(Model.Peran?.NamaPeran == "Pemilik Toko" ? "badge-danger" : (Model.Peran?.NamaPeran == "Karyawan" ? "badge-warning" : "badge-success"))">
                                 @(Model.Peran?.NamaPeran == "User" ? "Pelanggan" : Model.Peran?.NamaPeran)
                             </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Nomor Telepon</th>
                        <td>@(Model.NomorTelepon ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Alamat</th>
                        <td>@(Model.Alamat ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Dibuat Pada</th>
                        <td>@(Model.CreatedAt?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Diubah Pada</th>
                        <td>@(Model.UpdatedAt?.ToString("dd MMM yyyy HH:mm:ss") ?? "-")</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <a href="@Url.Action("Edit", new { id = Model.PenggunaId })" class="btn btn-warning text-white font-weight-bold">Ubah</a>
                <a href="@Url.Action("Index")" class="btn btn-default">Kembali</a>
            </div>
        </div>
    </div>
</div>
