@model CateringApp.Models.ViewModel.UploadPembayaranViewModel
@{
    ViewData["Title"] = "Upload Pembayaran";
}

<div class="row">
    <div class="col-md-6">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h3 class="card-title">Pembayaran Pesanan #@Model.NomorPesanan</h3>
            </div>
            
            <form asp-action="Bayar" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="PesananId" />
                <input type="hidden" asp-for="NomorPesanan" />
                <input type="hidden" asp-for="TotalBayar" />

                <div class="card-body">
                    <div class="alert alert-info">
                        <h5><i class="icon fas fa-info"></i> Petunjuk Pembayaran</h5>
                        Silakan transfer sebesar <strong>Rp @Model.TotalBayar.ToString("N0")</strong> ke salah satu rekening berikut:
                        <ul class="mb-0 mt-2">
                            <li>Bank Mandiri: <strong>123-456-7890 (A/N Catering App)</strong></li>
                            <li>GoPay / OVO: <strong>0812-3456-7890</strong></li>
                        </ul>
                    </div>

                    <div class="form-group">
                        <label>Total yang Harus Dibayar</label>
                        <input class="form-control" value="Rp @Model.TotalBayar.ToString("N0")" readonly disabled style="font-weight: bold; color: green; font-size: 1.1em;" />
                    </div>

                    <div class="form-group">
                        <label asp-for="MetodePembayaran">Pilih Metode Pembayaran</label>
                        <select asp-for="MetodePembayaran" class="form-control">
                            <option value="">-- Pilih Rekening Tujuan --</option>
                            <option value="Transfer Bank Mandiri">Transfer Bank Mandiri (123-456-7890)</option>
                            <option value="GoPay">GoPay (0812-3456-7890)</option>
                            <option value="OVO">OVO (0812-3456-7890)</option>
                        </select>
                        <span asp-validation-for="MetodePembayaran" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FileBukti">Unggah Bukti Transfer (JPG, PNG, atau PDF)</label>
                        <div class="custom-file">
                            <input asp-for="FileBukti" type="file" class="custom-file-input" id="customFile" accept="image/*,.pdf" />
                            <label class="custom-file-label" for="customFile">Pilih file bukti transfer...</label>
                        </div>
                        <span asp-validation-for="FileBukti" class="text-danger"></span>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success"><i class="fas fa-upload"></i> Kirim Bukti Pembayaran</button>
                    <a href="@Url.Action("Index")" class="btn btn-default">Kembali ke Daftar Pesanan</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Display selected file name in custom file input
        $(".custom-file-input").on("change", function () {
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
}
