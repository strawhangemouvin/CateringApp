@model CateringApp.Models.Entity.Pesanan
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Detail Pesanan #" + Model.NomorPesanan;
    var session = HttpContextAccessor.HttpContext?.Session;
    string? role = session?.GetString("Role");

    bool isPaymentVerified = Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Valid";
    bool isPaymentValid = isPaymentVerified;
    int stepProgress = Model.StatusPesanan switch
    {
        "Selesai" => 4,
        "Dikirim" => 3,
        "Diproses" => 2,
        _ => (isPaymentVerified ? 1 : 0)
    };
    bool isCancelled = Model.StatusPesanan == "Dibatalkan" || Model.StatusPesanan == "Batal";
    bool isOverdue = Model.StatusPesanan != "Selesai" && Model.StatusPesanan != "Refund Selesai" && Model.StatusPesanan != "Menunggu Refund" && !isCancelled && Model.TanggalPengiriman.Date < DateTime.Today;
}

<!-- Overdue Warning Banner -->
@if (isOverdue)
{
    @if (role == "Pemilik Toko" || role == "Karyawan")
    {
        <div class="alert alert-danger shadow-sm mb-4 border-0" style="border-radius: var(--radius-md);">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-circle fa-2x mr-3"></i>
                <div>
                    <h6 class="mb-1 font-weight-bold">Perhatian Operasional: Jadwal Pengiriman Telah Terlewat!</h6>
                    <small>Jadwal pengiriman pesanan ini adalah <strong>@Model.TanggalPengiriman.ToString("dd MMMM yyyy")</strong>, namun pesanan belum diselesaikan. Segera koordinasikan dengan tim dapur/kurir.</small>
                </div>
            </div>
        </div>
    }
    else if (role == "User")
    {
        <div class="alert alert-warning shadow-sm mb-4 border-0" style="background-color: #fff9e6; border-radius: var(--radius-md);">
            <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x mr-3 text-warning"></i>
                <div>
                    <h6 class="mb-1 font-weight-bold text-dark">Informasi Jadwal Pengiriman</h6>
                    <small class="text-secondary">Estimasi pengiriman untuk pesanan Anda adalah <strong>@Model.TanggalPengiriman.ToString("dd MMMM yyyy")</strong>. Tim katering kami sedang menangani pesanan Anda. Untuk informasi terkini, hubungi kami via WA di <a href="https://wa.me/6283148448516" target="_blank" class="font-weight-bold text-dark"><u>083148448516</u></a>.</small>
                </div>
            </div>
        </div>
    }
}

<!-- Modern Order Stepper Timeline -->
<div class="card-modern mb-4">
    <div class="card-header-modern d-flex align-items-center justify-content-between">
        <h5 class="font-heading font-weight-bold text-dark mb-0">
            <i class="fas fa-tasks text-danger mr-2"></i> Progres Pesanan #@Model.NomorPesanan
        </h5>
        <span class="badge-modern @(isCancelled && Model.StatusPesanan != "Refund Selesai" ? "badge-modern-danger" : (Model.StatusPesanan == "Selesai" || Model.StatusPesanan == "Refund Selesai" ? "badge-modern-success" : (Model.StatusPesanan == "Dikirim" ? "badge-modern-info" : "badge-modern-warning")))">
            <i class="fas fa-circle" style="font-size: 0.55rem;"></i> @Model.StatusPesanan
        </span>
    </div>

    <div class="card-body p-4">
        @if (Model.StatusPesanan == "Refund Selesai" || (!string.IsNullOrEmpty(Model.RefundBuktiTf) && isCancelled))
        {
            <div class="text-center py-4">
                <div class="stat-icon-wrapper mx-auto mb-3" style="background: #ecfdf5; color: #059669; width: 68px; height: 68px; font-size: 1.9rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);">
                    <i class="fas fa-hand-holding-usd"></i>
                </div>
                <h5 class="font-heading font-weight-bold text-success mb-2">Pengembalian Dana Berhasil (Refund Selesai)</h5>
                <p class="text-muted small mb-0" style="max-width: 580px; margin: 0 auto; line-height: 1.6;">
                    Dana pesanan sebesar <strong class="text-dark">Rp @Model.TotalBayar.ToString("N0")</strong> telah berhasil dikembalikan ke rekening <strong>@Model.RefundNamaBank - @Model.RefundNoRekening</strong> (a.n <strong>@Model.RefundAtasNama</strong>). Alur transaksi resmi tuntas dan ditutup.
                </p>
            </div>
        }
        else if (Model.StatusPesanan == "Menunggu Refund")
        {
            <div class="text-center py-4">
                <div class="stat-icon-wrapper mx-auto mb-3" style="background: #fffbeb; color: #d97706; width: 68px; height: 68px; font-size: 1.9rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.15);">
                    <i class="fas fa-clock"></i>
                </div>
                <h5 class="font-heading font-weight-bold text-warning mb-2">Pengajuan Pengembalian Dana Sedang Diproses</h5>
                <p class="text-muted small mb-0" style="max-width: 580px; margin: 0 auto; line-height: 1.6;">
                    Pengajuan refund sebesar <strong class="text-dark">Rp @Model.TotalBayar.ToString("N0")</strong> sedang dalam antrean transfer balik oleh Pemilik Toko ke rekening <strong>@Model.RefundNamaBank - @Model.RefundNoRekening</strong> (a.n <strong>@Model.RefundAtasNama</strong>).
                </p>
            </div>
        }
        else if (isCancelled)
        {
            <div class="text-center py-4">
                <div class="stat-icon-wrapper mx-auto mb-3" style="background: var(--danger-light); color: var(--danger); width: 64px; height: 64px; font-size: 1.8rem;">
                    <i class="fas fa-ban"></i>
                </div>
                <h5 class="font-heading font-weight-bold text-danger mb-1">Pesanan Dibatalkan</h5>
                <p class="text-muted small mb-0">Pesanan ini telah dibatalkan. Hubungi layanan pelanggan jika memerlukan bantuan refund dana.</p>
            </div>
        }
        else
        {
            <div class="stepper-scroll-container">
                <div class="stepper-inner position-relative py-3 mx-auto" style="max-width: 800px;">
                    <!-- Track Line Background -->
                    <div class="stepper-track-bg position-absolute" style="top: 36px; left: 10%; right: 10%; height: 5px; background-color: var(--slate-200); z-index: 1; border-radius: 4px;">
                        <div style="width: @(stepProgress * 25)%; height: 100%; background: linear-gradient(90deg, #e63946, #10b981); border-radius: 4px; transition: width 0.4s ease;"></div>
                    </div>

                    <div class="d-flex justify-content-between position-relative" style="z-index: 2;">
                        <!-- Step 1 -->
                        <div class="text-center" style="width: 100px;">
                            <div class="stepper-bead mx-auto mb-2 @(stepProgress > 0 ? "completed" : "active")">
                                <i class="fas @(stepProgress > 0 ? "fa-check" : "fa-receipt")"></i>
                            </div>
                            <span class="font-weight-bold d-block text-dark small">1. Dipesan</span>
                            <small class="text-muted" style="font-size: 0.72rem;">@Model.TanggalPesan.ToString("dd/MM HH:mm")</small>
                        </div>

                        <!-- Step 2 -->
                        <div class="text-center" style="width: 110px;">
                            <div class="stepper-bead mx-auto mb-2 @(stepProgress > 1 ? "completed" : (stepProgress == 1 ? "active" : "pending"))">
                                <i class="fas @(stepProgress > 1 ? "fa-check" : "fa-credit-card")"></i>
                            </div>
                            <span class="font-weight-bold d-block text-dark small">2. Terverifikasi</span>
                            <small class="text-muted" style="font-size: 0.72rem;">@(isPaymentVerified ? "Lunas" : "Menunggu Bayar")</small>
                        </div>

                        <!-- Step 3 -->
                        <div class="text-center" style="width: 100px;">
                            <div class="stepper-bead mx-auto mb-2 @(stepProgress > 2 ? "completed" : (stepProgress == 2 ? "active" : "pending"))">
                                <i class="fas @(stepProgress > 2 ? "fa-check" : "fa-fire")"></i>
                            </div>
                            <span class="font-weight-bold d-block text-dark small">3. Dimasak</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Dapur Katering</small>
                        </div>

                        <!-- Step 4 -->
                        <div class="text-center" style="width: 100px;">
                            <div class="stepper-bead mx-auto mb-2 @(stepProgress > 3 ? "completed" : (stepProgress == 3 ? "active" : "pending"))">
                                <i class="fas @(stepProgress > 3 ? "fa-check" : "fa-truck")"></i>
                            </div>
                            <span class="font-weight-bold d-block text-dark small">4. Dikirim</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Kurir Menuju Lokasi</small>
                        </div>

                        <!-- Step 5 -->
                        <div class="text-center" style="width: 100px;">
                            <div class="stepper-bead mx-auto mb-2 @(stepProgress >= 4 ? "completed" : "pending")">
                                <i class="fas @(stepProgress >= 4 ? "fa-check-double" : "fa-clock")"></i>
                            </div>
                            <span class="font-weight-bold d-block @(stepProgress >= 4 ? "text-success" : "text-muted") small">5. Selesai</span>
                            <small class="text-muted" style="font-size: 0.72rem;">Diterima</small>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row">
    <!-- Left Column: Order Items & Receipt Details -->
    <div class="col-lg-8 mb-4">
        <!-- Order Info Card -->
        <div class="card-modern mb-4">
            <div class="card-header-modern">
                <h5 class="font-heading font-weight-bold text-dark mb-0">
                    <i class="fas fa-info-circle text-primary mr-2"></i> Informasi Pesanan
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                        <small class="text-muted font-weight-bold text-uppercase d-block mb-1">Nomor Pesanan</small>
                        <span class="font-weight-bold text-primary" style="font-size: 1.05rem;">@Model.NomorPesanan</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted font-weight-bold text-uppercase d-block mb-1">Nama Pemesan</small>
                        @{
                            // Cek apakah pesanan walk-in (nama manual tersimpan di catatan detail)
                            string? walkInNama = null;
                            string? walkInTelp = null;
                            var catatanDetail = Model.DetailPesanans.FirstOrDefault()?.Catatan ?? "";
                            if (catatanDetail.StartsWith("[Pesanan Walk-in / WA:"))
                            {
                                // Format: [Pesanan Walk-in / WA: Nama (Telp) - Jam Antar: ...]
                                var match = System.Text.RegularExpressions.Regex.Match(
                                    catatanDetail, 
                                    @"\[Pesanan Walk-in / WA: (.+?) \((.+?)\)");
                                if (match.Success)
                                {
                                    walkInNama = match.Groups[1].Value.Trim();
                                    walkInTelp = match.Groups[2].Value.Trim();
                                }
                            }
                        }
                        @if (walkInNama != null)
                        {
                            <span class="font-weight-bold text-dark">
                                <i class="fas fa-user-tag text-warning mr-1" title="Tamu Walk-in / WA"></i>
                                @walkInNama
                                @if (walkInTelp != null && walkInTelp != "-")
                                {
                                    <small class="text-muted ml-1">(@walkInTelp)</small>
                                }
                            </span>
                            <small class="d-block text-warning mt-1" style="font-size:0.75rem;"><i class="fas fa-info-circle mr-1"></i>Tamu / Walk-in (Tanpa Akun)</small>
                        }
                        else
                        {
                            <span class="font-weight-bold text-dark">@Model.Pengguna?.NamaLengkap (@Model.Pengguna?.Username)</span>
                        }
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6 mb-3 mb-sm-0">
                        <small class="text-muted font-weight-bold text-uppercase d-block mb-1">Waktu Pemesanan</small>
                        <span class="text-dark">@Model.TanggalPesan.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted font-weight-bold text-uppercase d-block mb-1">Jadwal Pengiriman &amp; Jam Acara</small>
                        <span class="font-weight-bold text-danger" style="font-size: 1rem;">
                            <i class="fas fa-clock mr-1"></i> @Model.TanggalPengiriman.ToString("dd MMMM yyyy, HH:mm") WIB
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted font-weight-bold text-uppercase d-block mb-1">Alamat Tujuan Pengiriman</small>
                    <div class="p-3 bg-light rounded border">
                        <div class="font-weight-bold text-dark mb-2" style="font-size: 0.95rem; line-height: 1.4;">
                            <i class="fas fa-map-marker-alt text-danger mr-1"></i> @Model.AlamatPengiriman
                        </div>
                        @{
                            decimal subtotalMenuAwal = Model.DetailPesanans.Sum(d => d.Subtotal);
                            decimal ongkirInfo = (Model.TotalBayar > subtotalMenuAwal) 
                                ? (Model.TotalBayar - subtotalMenuAwal) 
                                : CateringApp.Helpers.OngkirHelper.HitungOngkir(Model.AlamatPengiriman);
                            var wilayahInfo = CateringApp.Helpers.OngkirHelper.CekWilayah(Model.AlamatPengiriman);
                        }
                        <div class="mt-2 pt-2 border-top">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div class="small text-muted d-flex align-items-center">
                                    <i class="fas fa-truck text-primary mr-2"></i>
                                    <span class="font-weight-bold">Rincian Ongkir:</span>
                                </div>
                                @if (ongkirInfo == 0)
                                {
                                    <span class="badge badge-success px-2 py-1 font-weight-bold" style="border-radius: 6px; font-size: 0.8rem;">
                                        <i class="fas fa-check-circle mr-1"></i> Gratis Ongkir (Area Lokal)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-info px-2 py-1 font-weight-bold text-white" style="border-radius: 6px; font-size: 0.8rem;">
                                        <i class="fas fa-shipping-fast mr-1"></i> Rp @ongkirInfo.ToString("N0")
                                    </span>
                                }
                            </div>
                            @if (wilayahInfo != null && !string.IsNullOrEmpty(wilayahInfo.NamaZona) && wilayahInfo.NamaZona != "Belum Diisi" && wilayahInfo.NamaZona != "Di Luar Jangkauan")
                            {
                                <div class="small text-muted mt-1 text-truncate" style="font-size: 0.78rem;">
                                    <i class="fas fa-map-pin text-secondary mr-1"></i> @wilayahInfo.NamaZona
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ordered Menu Items Receipt -->
        <div class="card-modern">
            <div class="card-header-modern d-flex justify-content-between align-items-center">
                <h5 class="font-heading font-weight-bold text-dark mb-0">
                    <i class="fas fa-utensils text-success mr-2"></i> Rincian Menu Dipesan
                </h5>
                <span class="badge badge-light px-3 py-1 font-weight-bold text-muted border">@Model.DetailPesanans.Count Jenis Menu</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small font-weight-bold">
                            <tr>
                                <th class="pl-4 py-3 border-top-0">Menu Paket</th>
                                <th class="py-3 border-top-0 text-center">Harga Satuan</th>
                                <th class="py-3 border-top-0 text-center">Porsi</th>
                                <th class="pr-4 py-3 border-top-0 text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.DetailPesanans)
                            {
                                <tr>
                                    <td class="pl-4 py-3">
                                        <div class="d-flex align-items-center">
                                            @{
                                                string imgUrl = CateringApp.Helpers.MenuImageHelper.GetGambarUrl(detail.Paket?.NamaPaket, detail.Paket?.Gambar);
                                            }
                                            <img src="@imgUrl" class="rounded shadow-xs mr-3" referrerpolicy="no-referrer" style="width: 46px; height: 46px; object-fit: cover; border-radius: 8px;" alt="@detail.Paket?.NamaPaket" onerror="this.src='/images/menu_box.svg';" />
                                            <div>
                                                <div class="font-weight-bold text-dark">@detail.Paket?.NamaPaket</div>
                                                <small class="text-muted">Catatan: @(detail.Catatan ?? "-")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center text-muted">Rp @detail.HargaSatuan.ToString("N0")</td>
                                    <td class="py-3 text-center font-weight-bold">@detail.Jumlah</td>
                                    <td class="pr-4 py-3 text-right font-weight-bold text-dark">Rp @detail.Subtotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            @{
                                decimal subtotalItems = Model.DetailPesanans.Sum(d => d.Subtotal);
                                decimal ongkirKurir = (Model.TotalBayar > subtotalItems) 
                                    ? (Model.TotalBayar - subtotalItems) 
                                    : CateringApp.Helpers.OngkirHelper.HitungOngkir(Model.AlamatPengiriman);
                                decimal totalKalkulasi = (Model.TotalBayar > subtotalItems) 
                                    ? Model.TotalBayar 
                                    : (subtotalItems + ongkirKurir);
                            }
                            <tr>
                                <td colspan="3" class="pl-4 py-2 text-muted font-weight-bold">Subtotal Menu</td>
                                <td class="pr-4 py-2 text-right font-weight-bold text-dark">Rp @subtotalItems.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="pl-4 py-2 text-muted font-weight-bold">
                                    Biaya Pengiriman (Ongkir)
                                    <small class="d-block text-muted" style="font-size: 0.75rem;">
                                        @CateringApp.Helpers.OngkirHelper.GetKeteranganOngkir(Model.AlamatPengiriman)
                                    </small>
                                </td>
                                <td class="pr-4 py-2 text-right font-weight-bold @(ongkirKurir == 0 ? "text-success" : "text-dark")">
                                    @(ongkirKurir == 0 ? "Gratis" : $"Rp {ongkirKurir:N0}")
                                </td>
                            </tr>
                            <tr class="border-top">
                                <td colspan="3" class="pl-4 py-3 font-weight-bold text-dark">Total Pembayaran</td>
                                <td class="pr-4 py-3 text-right font-heading font-weight-bold text-danger" style="font-size: 1.25rem;">
                                    Rp @totalKalkulasi.ToString("N0")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Payment Details, Admin Controls, & Customer Actions -->
    <div class="col-lg-4 mb-4">
        <!-- Payment Info Card -->
        <div class="card-modern mb-4">
            <div class="card-header-modern">
                <h5 class="font-heading font-weight-bold text-dark mb-0">
                    <i class="fas fa-credit-card text-success mr-2"></i> Status Pembayaran
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.Pembayaran != null)
                {
                    <div class="p-3 bg-light rounded-lg border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small font-weight-bold">Metode</span>
                            <span class="font-weight-bold text-dark">@Model.Pembayaran.MetodePembayaran</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small font-weight-bold">Jumlah Ditransfer</span>
                            <span class="font-weight-bold text-success">Rp @Model.Pembayaran.JumlahBayar.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small font-weight-bold">Waktu Bayar</span>
                            <span class="text-dark small">@Model.Pembayaran.TanggalBayar.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="text-muted small font-weight-bold">Verifikasi</span>
                            <span class="badge-modern @(Model.Pembayaran.StatusVerifikasi == "Valid" ? "badge-modern-success" : (Model.Pembayaran.StatusVerifikasi == "Tidak Valid" ? "badge-modern-danger" : "badge-modern-warning"))">
                                @Model.Pembayaran.StatusVerifikasi
                            </span>
                        </div>
                        @if (Model.StatusPesanan == "Refund Selesai" || !string.IsNullOrEmpty(Model.RefundBuktiTf))
                        {
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="text-muted small font-weight-bold">Status Dana</span>
                                <span class="badge-modern badge-modern-success font-weight-bold">
                                    <i class="fas fa-undo mr-1"></i> Telah Dikembalikan (Refund)
                                </span>
                            </div>
                        }
                        else if (Model.StatusPesanan == "Menunggu Refund")
                        {
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="text-muted small font-weight-bold">Status Dana</span>
                                <span class="badge-modern badge-modern-warning font-weight-bold">
                                    <i class="fas fa-clock mr-1"></i> Proses Pengembalian (Refund)
                                </span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Pembayaran.BuktiTransfer))
                    {
                        <div class="text-center mt-3">
                            <label class="font-weight-bold text-muted small d-block text-left mb-2">Bukti Pembayaran Pelanggan:</label>
                            @if (Model.Pembayaran.BuktiTransfer.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Model.Pembayaran.BuktiTransfer" class="btn btn-modern-outline w-100" target="_blank">
                                    <i class="fas fa-file-pdf text-danger mr-2"></i> Buka Dokumen Bukti (PDF)
                                </a>
                            }
                            else
                            {
                                <a href="@Model.Pembayaran.BuktiTransfer" target="_blank" class="d-block overflow-hidden rounded border shadow-sm">
                                    <img src="@Model.Pembayaran.BuktiTransfer" class="img-fluid" style="max-height: 220px; width: 100%; object-fit: contain; background: #fff;" alt="Bukti Transfer" />
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="stat-icon-wrapper mx-auto mb-2" style="background: var(--warning-light); color: var(--warning); width: 48px; height: 48px;">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h6 class="font-weight-bold text-dark mb-1">Belum Ada Pembayaran</h6>
                        <p class="text-muted small mb-3">Pesanan ini belum memiliki catatan bukti transfer pembayaran.</p>
                        @if (role == "User")
                        {
                            <a href="@Url.Action("Bayar", new { id = Model.PesananId })" class="btn btn-modern-primary w-100 font-weight-bold py-2 shadow-sm">
                                <i class="fas fa-credit-card mr-2"></i> Bayar Sekarang (Virtual Account / QRIS)
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Admin Control Panel -->
        @if (role == "Pemilik Toko" || role == "Karyawan")
        {
            <div class="card-modern mb-4">
                <div class="card-header-modern">
                    <h5 class="font-heading font-weight-bold text-dark mb-0">
                        <i class="fas fa-user-shield text-danger mr-2"></i> Kontrol Status & Verifikasi
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Payment Verification (Wewenang Khusus Owner) -->
                    @if (Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Menunggu Verifikasi")
                    {
                        <div class="mb-4 pb-3 border-bottom">
                            <label class="font-weight-bold text-dark small d-block mb-2">Aksi Verifikasi Pembayaran:</label>
                            @if (role == "Pemilik Toko")
                            {
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a href="@Url.Action("Verifikasi", new { id = Model.PesananId, status = "Valid" })" class="btn btn-sm btn-success btn-block font-weight-bold py-2 px-1" style="border-radius: var(--radius-md); font-size: 0.82rem;">
                                            <i class="fas fa-check mr-1"></i> Valid (Lunas)
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="@Url.Action("Verifikasi", new { id = Model.PesananId, status = "Tidak Valid" })" class="btn btn-sm btn-danger btn-block font-weight-bold py-2 px-1" style="border-radius: var(--radius-md); font-size: 0.82rem;">
                                            <i class="fas fa-times mr-1"></i> Tidak Valid
                                        </a>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning p-2 small mb-0" style="border-radius: var(--radius-md);">
                                    <i class="fas fa-shield-alt mr-1"></i> <strong>Pemisahan Tugas:</strong> Verifikasi bukti transfer bank merupakan wewenang <strong>Pemilik Toko (Owner)</strong> untuk mencegah fraud internal.
                                </div>
                            }
                        </div>
                    }

                    <!-- Stage Progress Buttons -->
                    <label class="font-weight-bold text-dark small d-block mb-2">Perbarui Status Alur Pesanan:</label>
                    @{
                        bool isOrderFinished = Model.StatusPesanan == "Selesai";
                        bool isOrderCancelled = Model.StatusPesanan == "Dibatalkan" || Model.StatusPesanan == "Batal";
                        bool isOrderRefunded = Model.StatusPesanan == "Refund Selesai" || (!string.IsNullOrEmpty(Model.RefundBuktiTf) && isCancelled);
                        bool isOrderWaitingRefund = Model.StatusPesanan == "Menunggu Refund";
                    }

                    @if (isOrderRefunded)
                    {
                        <div class="alert alert-success p-3 small mb-0" style="border-radius: var(--radius-md); background-color: #ecfdf5; border-color: #a7f3d0; color: #065f46;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle fa-2x mr-3 text-success"></i>
                                <div>
                                    <strong class="d-block font-weight-bold" style="font-size: 0.95rem;">Pengembalian Dana Tuntas</strong>
                                    <span>Dana telah berhasil ditransfer kembali ke rekening pelanggan. Alur transaksi resmi selesai &amp; terkunci.</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (isOrderWaitingRefund)
                    {
                        <div class="alert alert-warning p-3 small mb-0" style="border-radius: var(--radius-md); background-color: #fffbeb; border-color: #fde68a; color: #92400e;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-hand-holding-usd fa-2x mr-3 text-warning"></i>
                                <div>
                                    <strong class="d-block font-weight-bold" style="font-size: 0.95rem;">Menunggu Transfer Refund</strong>
                                    <span>Pelanggan mengajukan pengembalian dana. Lakukan transfer ke rekening di bawah, lalu unggah bukti transfer.</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (isOrderFinished)
                    {
                        <div class="alert alert-success p-3 small mb-0" style="border-radius: var(--radius-md);">
                            <i class="fas fa-check-double mr-1"></i> <strong>Pesanan Selesai</strong>: Makanan telah diterima pelanggan. Alur telah tuntas.
                        </div>
                    }
                    else if (isOrderCancelled)
                    {
                        <div class="alert alert-danger p-3 small mb-0" style="border-radius: var(--radius-md);">
                            <i class="fas fa-ban mr-1"></i> <strong>Pesanan Dibatalkan</strong>: Transaksi tidak dapat dilanjutkan.
                        </div>
                    }
                    else
                    {
                        if (!isPaymentValid)
                        {
                            <div class="alert alert-warning p-2 small mb-3" style="border-radius: var(--radius-md);">
                                <i class="fas fa-exclamation-triangle mr-1"></i> Pembayaran belum valid. Tombol proses & selesai dikunci.
                            </div>
                        }

                        <div class="d-flex flex-column" style="gap: 8px;">
                            <a href="@(isPaymentValid && Model.StatusPesanan == "Pending" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Diproses" }) : "#")" 
                               class="btn btn-sm text-left p-2 font-weight-bold @(Model.StatusPesanan == "Diproses" ? "btn-info text-white" : "btn-light border") @(isPaymentValid && Model.StatusPesanan == "Pending" ? "" : "disabled")" style="border-radius: var(--radius-md);">
                                <i class="fas fa-fire mr-2 text-warning"></i> 1. Mulai Diproses (Masak)
                            </a>

                            <a href="@(isPaymentValid && Model.StatusPesanan == "Diproses" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Dikirim" }) : "#")" 
                               class="btn btn-sm text-left p-2 font-weight-bold @(Model.StatusPesanan == "Dikirim" ? "btn-primary text-white" : "btn-light border") @(isPaymentValid && Model.StatusPesanan == "Diproses" ? "" : "disabled")" style="border-radius: var(--radius-md);">
                                <i class="fas fa-truck mr-2 text-primary"></i> 2. Kirim Pesanan (Kurir)
                            </a>

                            <a href="@(isPaymentValid && Model.StatusPesanan == "Dikirim" ? Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Selesai" }) : "#")" 
                               class="btn btn-sm text-left p-2 font-weight-bold btn-light border @(isPaymentValid && Model.StatusPesanan == "Dikirim" ? "text-success border-success" : "disabled")" style="border-radius: var(--radius-md);">
                                <i class="fas fa-check-circle mr-2 text-success"></i> 3. Tandai Selesai (Diterima)
                            </a>

                            @if (Model.StatusPesanan != "Dikirim")
                            {
                                <a href="@Url.Action("UpdateStatus", new { id = Model.PesananId, status = "Dibatalkan" })" 
                                   class="btn btn-sm btn-outline-danger text-left mt-2 p-2" style="border-radius: var(--radius-md);" 
                                   onclick="return confirm('Apakah Anda yakin ingin membatalkan pesanan ini?');">
                                    <i class="fas fa-times-circle mr-2"></i> Batalkan Pesanan
                                </a>
                            }
                            else
                            {
                                <div class="mt-2 text-muted small p-2 bg-light rounded border text-center">
                                    <i class="fas fa-ban mr-1 text-secondary"></i> Tidak dapat dibatalkan (Sedang dalam pengiriman kurir).
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Refund Management Card (If Refund Requested, Cancelled while Paid, or Completed) -->
        @{
            bool isPaidForRefund = Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Valid";
            bool requiresRefund = Model.StatusPesanan == "Menunggu Refund" || 
                                  Model.StatusPesanan == "Refund Selesai" || 
                                  ((Model.StatusPesanan == "Dibatalkan" || Model.StatusPesanan == "Batal") && isPaidForRefund) || 
                                  !string.IsNullOrEmpty(Model.RefundNamaBank);
        }

        @if (requiresRefund)
        {
            <div class="card-modern mb-4">
                <div class="card-header-modern" style="background-color: #fffbeb;">
                    <h5 class="font-heading font-weight-bold text-dark mb-0">
                        <i class="fas fa-hand-holding-usd text-warning mr-2"></i> Pengembalian Dana (Refund)
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-light rounded-lg border mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-1">
                            <span class="text-muted small">Status Refund</span>
                            @if (Model.StatusPesanan == "Refund Selesai" || !string.IsNullOrEmpty(Model.RefundBuktiTf))
                            {
                                <span class="badge badge-success px-2 py-1 font-weight-bold" style="border-radius: 6px; font-size: 0.78rem;">
                                    <i class="fas fa-check-circle mr-1"></i> Refund Selesai
                                </span>
                            }
                            else if (string.IsNullOrEmpty(Model.RefundNamaBank))
                            {
                                <span class="badge badge-danger px-2 py-1 font-weight-bold" style="border-radius: 6px; font-size: 0.78rem;">
                                    <i class="fas fa-exclamation-circle mr-1"></i> Butuh Rekening
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning px-2 py-1 font-weight-bold text-dark" style="border-radius: 6px; font-size: 0.78rem;">
                                    <i class="fas fa-clock mr-1"></i> Menunggu Transfer
                                </span>
                            }
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Total Dana Dikembalikan</span>
                            <span class="font-weight-bold text-danger" style="font-size: 1.05rem;">Rp @Model.TotalBayar.ToString("N0")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.RefundNamaBank))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Tujuan Bank / E-Wallet</span>
                                <span class="font-weight-bold text-dark">@Model.RefundNamaBank</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Nomor Rekening / HP</span>
                                <span class="font-weight-bold text-primary">@Model.RefundNoRekening</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Atas Nama</span>
                                <span class="font-weight-bold text-dark">@Model.RefundAtasNama</span>
                            </div>
                        }
                    </div>

                    @if (string.IsNullOrEmpty(Model.RefundNamaBank) && Model.StatusPesanan != "Refund Selesai")
                    {
                        @if (role == "Karyawan")
                        {
                            <div class="alert alert-warning border-0 rounded-lg p-3 mb-0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b !important;">
                                <div class="d-flex align-items-center mb-1 font-weight-bold text-warning">
                                    <i class="fas fa-shield-alt mr-2"></i> Wewenang Keuangan Khusus Owner &amp; Pelanggan
                                </div>
                                <p class="small text-muted mb-0">
                                    Pesanan ini telah dibatalkan dengan pembayaran lunas (<strong>Rp @Model.TotalBayar.ToString("N0")</strong>). Pengisian nomor rekening serta eksekusi pengembalian dana (refund) sepenuhnya ditangani oleh <strong>Pelanggan</strong> dan <strong>Pemilik Toko (Owner)</strong>. Karyawan tidak memiliki akses manipulasi rekening.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger border-0 rounded-lg p-3 mb-3" style="background-color: #fef2f2; border-left: 4px solid #ef4444 !important;">
                                <div class="d-flex align-items-center mb-1 font-weight-bold text-danger">
                                    <i class="fas fa-exclamation-triangle mr-2"></i> Pengembalian Dana Diperlukan
                                </div>
                                <p class="small text-muted mb-0">
                                    Pesanan ini telah dibatalkan namun pembayaran telah diverifikasi lunas (<strong>Rp @Model.TotalBayar.ToString("N0")</strong>). 
                                    @if (role == "User")
                                    {
                                        <span>Silakan isi formulir di bawah ini dengan nomor rekening atau nomor HP e-wallet Anda agar Pemilik Toko (Owner) dapat mentransfer balik dana Anda.</span>
                                    }
                                    else
                                    {
                                        <span>Nomor rekening pelanggan belum diisi oleh pelanggan. Anda (Owner) dapat mengisikan data rekening pelanggan di bawah jika menerima konfirmasi langsung via WhatsApp/Telepon.</span>
                                    }
                                </p>
                            </div>

                            <!-- Form Input Rekening Refund (Hanya untuk Pelanggan & Owner) -->
                            <div class="p-3 bg-white border rounded mb-3">
                                <h6 class="font-weight-bold text-dark mb-3">
                                    <i class="fas fa-edit text-primary mr-1"></i> 
                                    @(role == "Pemilik Toko" ? "Bantu Input Rekening Pelanggan (Khusus Owner)" : "Masukkan Rekening Pengembalian Dana Anda")
                                </h6>
                                <form asp-action="InputRekeningRefund" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="pesananId" value="@Model.PesananId" />
                                    <div class="form-group mb-2">
                                        <label class="font-weight-bold text-dark small">Bank / E-Wallet Tujuan <span class="text-danger">*</span></label>
                                        <select name="namaBank" class="form-control form-control-sm custom-select-scroll" required>
                                            <option value="">-- Pilih Bank / E-Wallet --</option>
                                            <option value="BCA">BCA (Bank Central Asia)</option>
                                            <option value="Bank Mandiri">Bank Mandiri</option>
                                            <option value="BRI">BRI (Bank Rakyat Indonesia)</option>
                                            <option value="BNI">BNI (Bank Negara Indonesia)</option>
                                            <option value="BSI">BSI (Bank Syariah Indonesia)</option>
                                            <option value="CIMB Niaga">CIMB Niaga</option>
                                            <option value="Bank Danamon">Bank Danamon</option>
                                            <option value="GoPay">GoPay</option>
                                            <option value="OVO">OVO</option>
                                            <option value="DANA">DANA</option>
                                            <option value="ShopeePay">ShopeePay</option>
                                            <option value="Lainnya">Bank Lainnya</option>
                                        </select>
                                    </div>
                                    <div class="form-group mb-2">
                                        <label class="font-weight-bold text-dark small">Nomor Rekening / No. HP Akun <span class="text-danger">*</span></label>
                                        <input type="text" name="noRekening" class="form-control form-control-sm" placeholder="Contoh: 1234567890 (8-20 digit angka)" required maxlength="20" minlength="8" pattern="^[0-9]{8,20}$" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 20);" />
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold text-dark small">Nama Pemilik Rekening <span class="text-danger">*</span></label>
                                        <input type="text" name="atasNama" class="form-control form-control-sm" placeholder="Nama pemilik rekening sesuai buku tabungan" required maxlength="70" minlength="3" />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm btn-block font-weight-bold shadow-sm">
                                        <i class="fas fa-save mr-1"></i> Simpan Data Rekening Refund
                                    </button>
                                </form>
                            </div>
                        }
                    }
                    else if (Model.StatusPesanan != "Refund Selesai" && string.IsNullOrEmpty(Model.RefundBuktiTf))
                    {
                        @if (role == "Pemilik Toko")
                        {
                            <form asp-action="KonfirmasiRefund" method="post" enctype="multipart/form-data" id="formKonfirmasiRefund" class="mt-3 p-3 bg-white border border-warning rounded shadow-sm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pesananId" value="@Model.PesananId" />
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge badge-danger mr-2 px-2 py-1">Tindakan Wajib Owner</span>
                                    <strong class="text-dark small">Transfer Pengembalian Dana: Rp @Model.TotalBayar.ToString("N0")</strong>
                                </div>
                                <p class="text-muted small mb-2">
                                    Silakan transfer ke rekening <strong>@Model.RefundNamaBank @Model.RefundNoRekening</strong> (a.n. <strong>@Model.RefundAtasNama</strong>), lalu unggah bukti transfer di bawah ini:
                                </p>
                                <div class="form-group mb-2">
                                    <label class="font-weight-bold text-dark small mb-1">
                                        <i class="fas fa-upload text-warning mr-1"></i> Unggah Bukti Transfer Refund (Wajib): <span class="text-danger">*</span>
                                    </label>
                                    <input type="file" id="fileBuktiTf" name="fileBuktiTf" class="form-control-file mb-1 small" required accept=".jpg,.jpeg,.png,.webp,.pdf" onchange="checkRefundUpload(this)" />
                                    <small class="text-muted d-block">Format: JPG, PNG, WEBP, atau PDF (Maks. 5MB)</small>
                                </div>

                                <!-- Preview / Info Berkas yang Dipilih -->
                                <div id="refundFileInfoBanner" class="alert alert-success py-2 px-3 small mb-3 align-items-center" style="display: none; border-radius: var(--radius-sm);">
                                    <i class="fas fa-check-circle text-success fa-lg mr-2"></i>
                                    <div class="text-truncate">
                                        <span class="font-weight-bold text-dark d-block text-truncate" id="refundFileName"></span>
                                        <small class="text-muted" id="refundFileSize"></small>
                                    </div>
                                </div>

                                <button type="submit" id="btnKonfirmasiRefund" class="btn btn-secondary btn-block font-weight-bold shadow-sm" disabled style="cursor: not-allowed; transition: all 0.25s ease;">
                                    <i class="fas fa-lock mr-1" id="iconKonfirmasiRefund"></i> 
                                    <span id="textKonfirmasiRefund">Unggah Bukti Transfer Dahulu</span>
                                </button>
                            </form>
                        }
                        else if (role == "Karyawan")
                        {
                            <div class="alert alert-warning small mb-0 mt-2 border-0">
                                <i class="fas fa-clock mr-1"></i> Data rekening pelanggan telah tersimpan. Pengajuan refund sedang menunggu transfer dan konfirmasi oleh <strong>Pemilik Toko (Owner)</strong>.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info small mb-0 mt-2 border-0">
                                <i class="fas fa-clock mr-1"></i> Data rekening Anda telah diterima. Pengajuan pengembalian dana sedang dalam antrean transfer oleh pihak keuangan Catering Mimi Saripah.
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.RefundBuktiTf))
                    {
                        <div class="text-center mt-3 pt-3 border-top">
                            <label class="font-weight-bold text-success small d-block mb-2">
                                <i class="fas fa-check-circle mr-1"></i> Bukti Transfer Pengembalian Dana:
                            </label>
                            @if (Model.RefundBuktiTf.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Model.RefundBuktiTf" target="_blank" class="btn btn-sm btn-outline-success font-weight-bold">
                                    <i class="fas fa-file-pdf mr-1"></i> Buka Bukti Transfer Balik (PDF)
                                </a>
                            }
                            else
                            {
                                <a href="@Model.RefundBuktiTf" target="_blank" class="d-inline-block border rounded shadow-xs overflow-hidden mb-2" style="max-width: 260px;">
                                    <img src="@Model.RefundBuktiTf" alt="Bukti Transfer Refund" class="img-fluid" style="max-height: 160px; object-fit: contain; background: #fff;" />
                                </a>
                                <br />
                                <a href="@Model.RefundBuktiTf" target="_blank" class="btn btn-sm btn-outline-success font-weight-bold">
                                    <i class="fas fa-external-link-alt mr-1"></i> Lihat Gambar Penuh
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Customer Actions & Refund -->
        @if (role == "User")
        {
            @if (Model.StatusPesanan == "Dikirim")
            {
                <div class="card-modern p-4 text-center">
                    <span class="badge-modern badge-modern-info mb-2 mx-auto">
                        <i class="fas fa-truck"></i> Sedang Dalam Pengiriman
                    </span>
                    <h6 class="font-heading font-weight-bold text-dark mt-1 mb-1">Kurir Sedang Menuju Alamat Anda</h6>
                    <p class="text-muted small mb-0">Pesanan Anda saat ini dalam proses pengantaran ke lokasi. Pesanan yang sedang dikirim tidak dapat dibatalkan.</p>
                </div>
            }
            else if (Model.StatusPesanan != "Selesai" && Model.StatusPesanan != "Dibatalkan" && Model.StatusPesanan != "Menunggu Refund" && Model.StatusPesanan != "Refund Selesai")
            {
                double selisihHariAcara = (Model.TanggalPengiriman.Date - DateTime.Today).TotalDays;
                bool isCutoffH2Passed = selisihHariAcara < 2;

                <div class="card-modern p-4">
                    <h6 class="font-heading font-weight-bold text-dark mb-2">Bantuan &amp; Pembatalan Pesanan</h6>

                    @if (isCutoffH2Passed)
                    {
                        <!-- H-2 Cutoff Passed: Disable cancellation -->
                        <div class="alert alert-warning border-0 rounded-lg p-3 small mb-0" style="background-color: #fff7ed; border-left: 4px solid #f97316 !important;">
                            <div class="d-flex align-items-center mb-1 font-weight-bold text-dark">
                                <i class="fas fa-clock text-warning mr-2"></i> Batas Waktu Pembatalan Mandiri Ditutup (H-2 Cutoff)
                            </div>
                            <p class="text-muted mb-0" style="font-size: 0.8rem;">
                                Pesanan untuk acara tanggal <strong>@Model.TanggalPengiriman.ToString("dd MMMM yyyy")</strong> telah memasuki tahap persiapan bahan baku dan operasional dapur. Pembatalan mandiri sudah tidak dapat dilakukan. Hubungi admin/CS kami jika ada hal mendesak.
                            </p>
                        </div>
                    }
                    else
                    {
                        @if (isPaymentValid || (Model.Pembayaran != null && Model.Pembayaran.StatusVerifikasi == "Menunggu Verifikasi"))
                        {
                            <button type="button" class="btn btn-outline-danger btn-block py-2 font-weight-bold" data-toggle="modal" data-target="#modalRefund" style="border-radius: var(--radius-md);">
                                <i class="fas fa-times-circle mr-1"></i> Batalkan Pesanan &amp; Ajukan Refund
                            </button>
                            <small class="text-muted d-block text-center mt-2" style="font-size: 0.76rem;">
                                <i class="fas fa-info-circle mr-1 text-primary"></i> Pengajuan refund mandiri dapat dilakukan maksimal H-2 sebelum acara.
                            </small>
                        }
                        else if (Model.StatusPesanan == "Pending")
                        {
                            <a href="@Url.Action("Delete", new { id = Model.PesananId })" class="btn btn-outline-danger btn-block py-2 font-weight-bold" style="border-radius: var(--radius-md);" onclick="return confirm('Apakah Anda yakin ingin membatalkan pesanan ini?');">
                                <i class="fas fa-trash-alt mr-1"></i> Batalkan Pesanan
                            </a>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Modal Form Refund Pelanggan -->
<div class="modal fade" id="modalRefund" tabindex="-1" role="dialog" aria-labelledby="modalRefundLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--radius-lg); overflow: hidden;">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-heading font-weight-bold" id="modalRefundLabel">
                    <i class="fas fa-hand-holding-usd mr-2"></i> Pengajuan Pengembalian Dana (Refund)
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="AjukanRefund" method="post" id="formAjukanRefund">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pesananId" value="@Model.PesananId" />
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 border-0">
                        <i class="fas fa-info-circle mr-1"></i> Dana yang dikembalikan adalah penuh sebesar <strong>Rp @Model.TotalBayar.ToString("N0")</strong>. Mohon pastikan data rekening tujuan benar dan aktif.
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark small">Nama Bank / E-Wallet <span class="text-danger">*</span></label>
                        <select name="namaBank" class="form-control custom-select-scroll" required style="border-radius: var(--radius-sm);">
                            <option value="">-- Pilih Bank / E-Wallet --</option>
                            <option value="BCA">BCA (Bank Central Asia)</option>
                            <option value="Bank Mandiri">Bank Mandiri</option>
                            <option value="BRI">BRI (Bank Rakyat Indonesia)</option>
                            <option value="BNI">BNI (Bank Negara Indonesia)</option>
                            <option value="BSI">BSI (Bank Syariah Indonesia)</option>
                            <option value="CIMB Niaga">CIMB Niaga</option>
                            <option value="Bank Danamon">Bank Danamon</option>
                            <option value="Bank Permata">Bank Permata</option>
                            <option value="GoPay">GoPay</option>
                            <option value="OVO">OVO</option>
                            <option value="DANA">DANA</option>
                            <option value="ShopeePay">ShopeePay</option>
                            <option value="Lainnya">Bank Lainnya</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark small">Nomor Rekening / No. HP Akun <span class="text-danger">*</span></label>
                        <input type="text" name="noRekening" class="form-control" placeholder="Contoh: 1234567890 (8-20 digit angka)" required maxlength="20" minlength="8" pattern="^[0-9]{8,20}$" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 20);" style="border-radius: var(--radius-sm);" />
                        <small class="text-muted" style="font-size: 0.76rem;">Hanya angka (8 - 20 digit tanpa spasi atau tanda hubung).</small>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-dark small">Nama Pemilik Rekening <span class="text-danger">*</span></label>
                        <input type="text" name="atasNama" class="form-control" placeholder="Contoh: Ahmad Fauzi (sesuai buku tabungan)" required maxlength="50" minlength="3" pattern="^[a-zA-Z\s\.\',]{3,50}$" oninput="this.value = this.value.replace(/[^a-zA-Z\s\.\',]/g, '').slice(0, 50);" style="border-radius: var(--radius-sm);" />
                        <small class="text-muted" style="font-size: 0.76rem;">Hanya huruf, spasi, dan titik (3 - 50 karakter).</small>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 p-3">
                    <button type="button" class="btn btn-modern-outline" data-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-modern-primary" onclick="return confirm('Apakah data rekening pengembalian dana sudah benar?');">
                        <i class="fas fa-paper-plane mr-1"></i> Konfirmasi Pembatalan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkRefundUpload(input) {
            var btn = document.getElementById('btnKonfirmasiRefund');
            var info = document.getElementById('refundFileInfoBanner');
            var nameSpan = document.getElementById('refundFileName');
            var sizeSmall = document.getElementById('refundFileSize');
            var icon = document.getElementById('iconKonfirmasiRefund');
            var text = document.getElementById('textKonfirmasiRefund');

            if (input.files && input.files.length > 0) {
                var file = input.files[0];
                var ext = file.name.split('.').pop().toLowerCase();
                var allowedExt = ['jpg', 'jpeg', 'png', 'webp', 'pdf'];

                if (!allowedExt.includes(ext)) {
                    Swal.fire({
                        title: 'Format Tidak Didukung',
                        text: 'Format berkas bukti transfer tidak didukung! Harap pilih gambar (JPG, PNG, WEBP) atau PDF.',
                        icon: 'error',
                        confirmButtonText: 'Pilih Berkas Lain',
                        customClass: {
                            confirmButton: 'btn btn-danger px-4 font-weight-bold'
                        },
                        buttonsStyling: false
                    });
                    input.value = '';
                    resetRefundButton();
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        title: 'Ukuran Berkas Terlalu Besar',
                        text: 'Maksimal ukuran berkas bukti transfer adalah 5 MB.',
                        icon: 'warning',
                        confirmButtonText: 'Pilih Berkas Lain',
                        customClass: {
                            confirmButton: 'btn btn-warning px-4 font-weight-bold text-dark'
                        },
                        buttonsStyling: false
                    });
                    input.value = '';
                    resetRefundButton();
                    return;
                }

                var sizeKb = Math.round(file.size / 1024);
                if (nameSpan) nameSpan.innerText = file.name;
                if (sizeSmall) sizeSmall.innerText = 'Ukuran: ' + (sizeKb > 1024 ? (sizeKb / 1024).toFixed(2) + ' MB' : sizeKb + ' KB');
                if (info) info.style.display = 'flex';

                if (btn) {
                    btn.disabled = false;
                    btn.className = 'btn btn-warning btn-block font-weight-bold shadow-sm text-dark';
                    btn.style.cursor = 'pointer';
                }
                if (icon) icon.className = 'fas fa-check-circle mr-1';
                if (text) text.innerText = 'Konfirmasi Selesai Refund & Simpan Bukti';
            } else {
                resetRefundButton();
            }
        }

        function resetRefundButton() {
            var btn = document.getElementById('btnKonfirmasiRefund');
            var info = document.getElementById('refundFileInfoBanner');
            var icon = document.getElementById('iconKonfirmasiRefund');
            var text = document.getElementById('textKonfirmasiRefund');

            if (info) info.style.display = 'none';
            if (btn) {
                btn.disabled = true;
                btn.className = 'btn btn-secondary btn-block font-weight-bold shadow-sm';
                btn.style.cursor = 'not-allowed';
            }
            if (icon) icon.className = 'fas fa-lock mr-1';
            if (text) text.innerText = 'Unggah Bukti Transfer Dahulu';
        }

        document.addEventListener('DOMContentLoaded', function() {
            var form = document.getElementById('formKonfirmasiRefund');
            if (form) {
                var isSubmitting = false;
                form.addEventListener('submit', function(e) {
                    if (isSubmitting) return true;
                    e.preventDefault();

                    var fileInput = document.getElementById('fileBuktiTf');
                    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                        Swal.fire({
                            title: 'Bukti Transfer Wajib',
                            text: 'Harap pilih berkas bukti transfer pengembalian dana terlebih dahulu.',
                            icon: 'warning',
                            confirmButtonText: 'Baik, Saya Pilih',
                            customClass: {
                                confirmButton: 'btn btn-warning font-weight-bold px-4 text-dark'
                            },
                            buttonsStyling: false
                        });
                        return false;
                    }

                    var fileName = fileInput.files[0].name;

                    Swal.fire({
                        title: 'Konfirmasi Pengembalian Dana',
                        html: `
                            <div class="text-left p-3 rounded mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.92rem;">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Nominal Refund:</span>
                                    <strong class="text-danger" style="font-size: 1.05rem;">Rp @Model.TotalBayar.ToString("N0")</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Bank / E-Wallet:</span>
                                    <strong class="text-dark">@Model.RefundNamaBank (@Model.RefundNoRekening)</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Atas Nama:</span>
                                    <strong class="text-dark">@Model.RefundAtasNama</strong>
                                </div>
                                <div class="d-flex justify-content-between pt-2 border-top">
                                    <span class="text-muted">Berkas Bukti:</span>
                                    <span class="text-success font-weight-bold text-truncate" style="max-width: 190px;"><i class="fas fa-file-invoice mr-1"></i>${fileName}</span>
                                </div>
                            </div>
                            <p class="text-muted mb-0" style="font-size: 0.88rem;">
                                Pastikan dana telah benar-benar ditransfer ke rekening pelanggan. Status pesanan akan diselesaikan menjadi <strong>Refund Selesai</strong>.
                            </p>
                        `,
                        icon: 'question',
                        iconColor: '#f59e0b',
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-check-circle mr-1"></i> Ya, Konfirmasi Selesai',
                        cancelButtonText: '<i class="fas fa-times mr-1"></i> Periksa Kembali',
                        customClass: {
                            confirmButton: 'btn btn-warning font-weight-bold px-4 py-2 mx-1 text-dark shadow-sm',
                            cancelButton: 'btn btn-outline-secondary px-4 py-2 mx-1 font-weight-bold'
                        },
                        buttonsStyling: false,
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            isSubmitting = true;
                            Swal.fire({
                                title: 'Menyimpan Konfirmasi...',
                                text: 'Mohon tunggu, sistem sedang mengunggah berkas bukti refund.',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                            form.submit();
                        }
                    });
                    return false;
                });
            }
        });
    </script>
}
