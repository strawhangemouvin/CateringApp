@{
    ViewData["Title"] = "422 - Validasi Data Gagal";
}
<div class="error-page mt-5">
    <h2 class="headline text-warning">422</h2>
    <div class="error-content">
        <h3><i class="fas fa-exclamation-circle text-warning"></i> Kesalahan Validasi Data (Unprocessable Entity).</h3>
        <p>
            Data yang Anda kirimkan tidak dapat diproses karena gagal memenuhi aturan validasi sistem.
            Silakan perbaiki isian formulir Anda atau kembali ke <a href="javascript:history.back()">Halaman Sebelumnya</a>.
        </p>
    </div>
</div>
