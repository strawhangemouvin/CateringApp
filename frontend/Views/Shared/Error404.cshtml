@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var role = session?.GetString("Role");
    bool isGuest = string.IsNullOrEmpty(role);
    Layout = isGuest ? "~/frontend/Views/Shared/_GuestLayout.cshtml" : "_Layout";
    ViewData["Title"] = "404 - Halaman Tidak Ditemukan";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="py-4">
                <div class="display-1 font-weight-bold text-warning mb-3 fw-bold">404</div>
                <h3 class="font-weight-bold text-dark mb-3 fw-bold">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i> Halaman Tidak Ditemukan
                </h3>
                <p class="text-muted mb-4 lead" style="font-size: 1.05rem;">
                    Halaman yang Anda cari tidak dapat ditemukan, telah dipindahkan, atau tautan yang Anda tuju salah.
                </p>
                <div class="d-flex justify-content-center flex-wrap" style="gap: 12px;">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-danger px-4 py-2 rounded-pill font-weight-bold mx-2 my-1">
                        <i class="fas fa-home me-1 mr-1"></i> Kembali ke Beranda
                    </a>
                    @if (!isGuest)
                    {
                        <a href="@Url.Action("Index", "Pesanan")" class="btn btn-outline-secondary px-4 py-2 rounded-pill mx-2 my-1">
                            <i class="fas fa-clipboard-list me-1 mr-1"></i> Daftar Pesanan
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
