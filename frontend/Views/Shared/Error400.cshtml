@{
    ViewData["Title"] = "400 - Permintaan Tidak Valid";
}
<div class="error-page mt-5">
    <h2 class="headline text-danger">400</h2>
    <div class="error-content">
        <h3><i class="fas fa-ban text-danger"></i> Permintaan Tidak Valid (Bad Request).</h3>
        <p>
            Permintaan Anda tidak dapat diproses oleh server karena format atau parameter yang dikirim tidak sesuai ketentuan.
            Silakan periksa kembali isian Anda atau kembali ke <a href="@Url.Action("Index", "Home")">Halaman Utama</a>.
        </p>
    </div>
</div>
