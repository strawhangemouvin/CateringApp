@{
    ViewData["Title"] = "403 - Akses Dilarang";
}
<div class="error-page mt-5">
    <h2 class="headline text-danger">403</h2>
    <div class="error-content">
        <h3><i class="fas fa-exclamation-triangle text-danger"></i> Akses Dilarang.</h3>
        <p>
            Anda tidak memiliki hak akses (privilese) untuk mengakses halaman ini.
            Jika Anda merasa ini adalah kesalahan, hubungi administrator atau kembali ke <a href="@Url.Action("Index", "Pesanan")">Daftar Pesanan</a>.
        </p>
    </div>
</div>
