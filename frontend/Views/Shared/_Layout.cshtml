@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject CateringApp.Services.Interface.ICateringService CateringService
@using CateringApp.Helpers
@using CateringApp.Models.ViewModel
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string? role = session?.GetString("Role");
    string? nama = session?.GetString("Nama") ?? "Guest";
    int? userId = session?.GetInt32("UserId");
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    var cartList = session?.GetObjectFromJson<List<CartItem>>("Cart") ?? new List<CartItem>();
    int cartItemCount = cartList.Count;

    var notifikasiList = !string.IsNullOrEmpty(role) ? CateringService.GetNotifikasiList(role, userId) : new List<NotifikasiItemViewModel>();

    // Saring notifikasi agar badge HANYA memuat tugas aktif yang memerlukan tindakan langsung:
    // Pesanan 'Pending' (belum dibayar pembeli) adalah status pasif menunggu pembayaran, bukan aksi wajib pemilik/staf.
    notifikasiList = notifikasiList.Where(n => !n.Judul.Contains("Pesanan Baru Masuk")).ToList();

    // Pastikan jika ada pembayaran yang butuh verifikasi masuk ke notifikasi Owner
    if ((role == "Pemilik Toko" || role == "Owner") && !notifikasiList.Any(n => n.Judul.Contains("Verifikasi Bukti Transfer")))
    {
        var summary = CateringService.GetDashboardSummary();
        if (summary.PesananButuhVerifikasi.Any())
        {
            foreach (var unv in summary.PesananButuhVerifikasi.Take(5))
            {
                notifikasiList.Add(new NotifikasiItemViewModel
                {
                    Judul = "Verifikasi Bukti Transfer!",
                    Pesan = $"Pelanggan {unv.Pengguna?.NamaLengkap ?? "Pelanggan"} mengunggah bukti bayar untuk {unv.NomorPesanan}.",
                    Url = $"/Pesanan/Details/{unv.PesananId}",
                    Waktu = unv.Pembayaran != null ? unv.Pembayaran.TanggalBayar.ToString("dd MMM HH:mm") : "Hari ini",
                    Tipe = "warning",
                    Icon = "fa-receipt"
                });
            }
        }
    }

    int notifCount = notifikasiList.Count;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"]?.ToString()?.Contains("Mimi Saripah") == true ? ViewData["Title"] : $"{ViewData["Title"]} - Catering Mimi Saripah")</title>
    
    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <!-- Base Framework (AdminLTE + Bootstrap) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Modern Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <style>
        /* Modern Sidebar Styling */
        .main-sidebar.modern-sidebar-custom {
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.07);
            box-shadow: 4px 0 25px rgba(0, 0, 0, 0.12) !important;
        }

        /* Fix AdminLTE layout-fixed spacing: eliminate unwanted 57px top margin under brand link */
        .layout-fixed .main-sidebar.modern-sidebar-custom .sidebar,
        .main-sidebar.modern-sidebar-custom .sidebar {
            margin-top: 0 !important;
            padding-top: 6px !important;
        }

        .modern-brand-link {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            padding: 14px 16px !important;
            display: flex;
            align-items: center;
            text-decoration: none !important;
            height: auto !important;
        }

        .modern-sidebar-user {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 12px !important;
            padding: 10px 14px !important;
            margin: 10px 12px 14px 12px !important;
            width: calc(100% - 24px) !important;
            display: flex !important;
            align-items: center !important;
            box-sizing: border-box !important;
        }

        .nav-sidebar {
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
        }

        .nav-sidebar .nav-item {
            margin-bottom: 4px !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .nav-sidebar .nav-link {
            border-radius: 12px !important;
            color: #94a3b8 !important;
            font-weight: 600 !important;
            font-size: 0.92rem !important;
            padding: 10px 14px !important;
            margin: 2px 12px !important;
            width: calc(100% - 24px) !important;
            border: 1px solid transparent !important;
            box-sizing: border-box !important;
            display: flex !important;
            align-items: center !important;
            transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease !important;
            transform: none !important;
        }

        .nav-sidebar .nav-link:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.08) !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            transform: none !important;
        }

        .nav-sidebar .nav-link.active {
            background: linear-gradient(135deg, #e63946 0%, #c92a37 100%) !important;
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            box-shadow: 0 4px 15px rgba(230, 57, 70, 0.35) !important;
            font-weight: 700 !important;
            transform: none !important;
        }

        .nav-sidebar .nav-link i.nav-icon {
            font-size: 1.05rem !important;
            margin-right: 12px !important;
            width: 20px !important;
            text-align: center !important;
        }

        /* Modern Topbar */
        .modern-topbar {
            background: rgba(255, 255, 255, 0.96) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--slate-200) !important;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
            padding: 8px 18px !important;
            height: 64px !important;
            min-height: 64px !important;
        }

        .layout-navbar-fixed .wrapper .content-wrapper {
            margin-top: 64px !important;
            padding-top: 20px !important;
        }

        .content-wrapper {
            background-color: #f8fafc !important;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
    <div class="wrapper">
        <!-- Modern Topbar Navbar -->
        <nav class="main-header navbar navbar-expand modern-topbar">
            <!-- Left Side Navbar -->
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <a class="nav-link text-dark p-2" data-widget="pushmenu" href="#" role="button" title="Buka/Tutup Menu" style="font-size: 1.15rem;">
                        <i class="fas fa-bars-staggered text-danger"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block ml-2">
                    <span class="font-weight-bold text-dark font-heading" style="font-size: 1.05rem;">
                        @ViewData["Title"]
                    </span>
                </li>
            </ul>

            <!-- Right Side Navbar -->
            <ul class="navbar-nav ml-auto align-items-center" style="gap: 8px;">
                @if (role == "User")
                {
                    <!-- Cart Quick Pill Button -->
                    <li class="nav-item mr-1">
                        <a href="@Url.Action("Index", "Cart")" class="cart-pill-btn" style="padding: 6px 14px; font-size: 0.85rem;">
                            <i class="fas fa-shopping-basket"></i>
                            <span class="d-none d-sm-inline">Keranjang</span>
                            <span class="cart-badge-count" style="width: 20px; height: 20px; font-size: 0.7rem;">@cartItemCount</span>
                        </a>
                    </li>
                }

                <li class="nav-item">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-sm btn-modern-outline" style="padding: 6px 14px; font-size: 0.85rem; border-radius: var(--radius-pill);">
                        <i class="fas fa-store mr-1"></i> Beranda Toko
                    </a>
                </li>

                <!-- User Dropdown Menu -->
                <li class="nav-item dropdown">
                    <div class="customer-user-menu dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="padding: 5px 12px;">
                        <div class="customer-avatar" style="width: 28px; height: 28px; font-size: 0.8rem; background: linear-gradient(135deg, #e63946 0%, #f59e0b 100%);">
                            @(string.IsNullOrEmpty(nama) ? "U" : nama.Substring(0, 1).ToUpper())
                        </div>
                        <span class="d-none d-lg-inline text-truncate font-weight-bold" style="max-width: 140px; font-size: 0.88rem;">@nama</span>
                    </div>
                    <div class="dropdown-menu dropdown-menu-right mt-2 shadow-lg border-0" style="border-radius: var(--radius-md); min-width: 200px;">
                        <div class="px-3 py-2 border-bottom">
                            <div class="font-weight-bold text-dark text-truncate">@nama</div>
                            <span class="badge-role-pastel">@(role == "User" ? "Pelanggan" : (role == "Pemilik Toko" ? "Pemilik Toko" : role))</span>
                        </div>
                        <a class="dropdown-item mt-1" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-store mr-2 text-warning"></i> Beranda Toko
                        </a>
                        <a class="dropdown-item" href="@Url.Action("Index", "Dashboard")">
                            <i class="fas fa-tachometer-alt mr-2 text-primary"></i> Dasbor
                        </a>
                        <a class="dropdown-item" href="@Url.Action("Index", "Pesanan")">
                            <i class="fas fa-receipt mr-2 text-success"></i> @(role == "User" ? "Pesanan Saya" : "Daftar Pesanan")
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-danger font-weight-bold" href="@Url.Action("Logout", "Account")" onclick="return confirm('Apakah Anda yakin ingin keluar dari sesi?');">
                            <i class="fas fa-sign-out-alt mr-2"></i> Keluar
                        </a>
                    </div>
                </li>

                <!-- Notification Bell Dropdown (Paling Kanan) -->
                @if (!string.IsNullOrEmpty(role))
                {
                    <li class="nav-item dropdown ml-1">
                        <a class="nav-link text-dark position-relative d-flex align-items-center justify-content-center p-0" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false" title="Pusat Notifikasi" style="width: 38px; height: 38px; border-radius: 50%; background: rgba(15, 23, 42, 0.05); transition: background 0.2s ease;">
                            <i class="far fa-bell text-dark" style="font-size: 1.15rem;"></i>
                            @if (notifCount > 0)
                            {
                                <span class="badge badge-danger position-absolute font-weight-bold" style="top: -2px; right: -2px; font-size: 0.65rem; border-radius: 10px; padding: 2px 5px; box-shadow: 0 2px 5px rgba(225, 29, 72, 0.4);">
                                    @notifCount
                                </span>
                            }
                        </a>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right mt-2 shadow-lg border-0 notif-dropdown-menu">
                            <div class="px-3 py-2 border-bottom d-flex align-items-center justify-content-between bg-light" style="border-top-left-radius: var(--radius-md); border-top-right-radius: var(--radius-md);">
                                <div class="font-weight-bold text-dark" style="font-size: 0.9rem;">
                                    <i class="fas fa-bell text-danger mr-1"></i> Notifikasi Tugas
                                </div>
                                @if (notifCount > 0)
                                {
                                    <span class="badge badge-danger px-2 py-1 font-weight-bold" style="font-size: 0.72rem;">@notifCount Perlu Aksi</span>
                                }
                            </div>

                            <div style="max-height: 340px; overflow-y: auto;">
                                @if (notifCount == 0)
                                {
                                    <div class="p-4 text-center text-muted">
                                        <i class="fas fa-check-circle text-success mb-2" style="font-size: 2rem;"></i>
                                        <p class="mb-0 font-weight-bold text-dark" style="font-size: 0.88rem;">Semua Tugas Selesai</p>
                                        <small style="font-size: 0.75rem;">Tidak ada pemberitahuan mendesak saat ini.</small>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var notif in notifikasiList)
                                    {
                                        <a href="@notif.Url" class="dropdown-item py-2 px-3 border-bottom d-flex align-items-start" style="white-space: normal; text-decoration: none;">
                                            <div class="mr-2 mt-1 flex-shrink-0">
                                                <span class="badge badge-@notif.Tipe p-2" style="border-radius: 8px; font-size: 0.85rem;">
                                                    <i class="fas @notif.Icon"></i>
                                                </span>
                                            </div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <div class="font-weight-bold text-dark small" style="line-height: 1.2;">@notif.Judul</div>
                                                <div class="text-muted mt-1" style="font-size: 0.76rem; line-height: 1.3;">@notif.Pesan</div>
                                                <small class="text-muted d-block mt-1" style="font-size: 0.68rem;">
                                                    <i class="far fa-clock mr-1"></i>@notif.Waktu
                                                </small>
                                            </div>
                                        </a>
                                    }
                                }
                            </div>

                            <div class="p-2 text-center bg-light border-top" style="border-bottom-left-radius: var(--radius-md); border-bottom-right-radius: var(--radius-md);">
                                @if (role == "Pemilik Toko")
                                {
                                    <a href="@Url.Action("Index", "Dashboard")" class="small text-primary font-weight-bold">
                                        <i class="fas fa-tachometer-alt mr-1"></i> Buka Dasbor Pemilik
                                    </a>
                                }
                                else if (role == "Karyawan")
                                {
                                    <a href="@Url.Action("Index", "Dashboard")" class="small text-primary font-weight-bold">
                                        <i class="fas fa-tachometer-alt mr-1"></i> Buka Dasbor Operasional
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index", "Pesanan")" class="small text-primary font-weight-bold">
                                        <i class="fas fa-receipt mr-1"></i> Lihat Pesanan Saya
                                    </a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </nav>

        <!-- Modern Main Sidebar -->
        <aside class="main-sidebar modern-sidebar-custom elevation-0">
            <!-- Brand Link -->
            <a href="@Url.Action("Index", "Dashboard")" class="modern-brand-link">
                <div class="customer-brand-icon mr-3" style="width: 38px; height: 38px; font-size: 1rem; flex-shrink: 0;">
                    <i class="fas fa-utensils"></i>
                </div>
                <div class="text-truncate">
                    <div class="font-heading font-weight-bold text-white text-truncate" style="font-size: 1.05rem; letter-spacing: 0.3px; line-height: 1.2;">
                        MIMI SARIPAH
                    </div>
                    <small class="text-uppercase font-weight-bold" style="font-size: 0.65rem; color: #ff8a95; letter-spacing: 1px;">
                        Catering Nusantara
                    </small>
                </div>
            </a>

            <!-- Sidebar Container -->
            <div class="sidebar pb-4">
                <!-- User Profile Card in Sidebar -->
                <div class="modern-sidebar-user">
                    <div class="customer-avatar mr-3" style="width: 36px; height: 36px; font-size: 0.95rem; flex-shrink: 0; background: linear-gradient(135deg, #e63946 0%, #c92a37 100%);">
                        @(string.IsNullOrEmpty(nama) ? "U" : nama.Substring(0, 1).ToUpper())
                    </div>
                    <div class="text-truncate">
                        <span class="d-block text-white font-weight-bold text-truncate" style="font-size: 0.9rem;">@nama</span>
                        <span class="badge-role-sidebar">@(role == "User" ? "Pelanggan" : (role == "Pemilik Toko" ? "Pemilik Toko" : role))</span>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-header text-uppercase text-muted font-weight-bold px-3 mb-1" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                            Menu Utama
                        </li>

                        <!-- Dasbor -->
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(currentController == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>@(role == "Pemilik Toko" ? "Dasbor Pemilik" : (role == "Karyawan" ? "Dasbor Operasional" : "Dasbor Pelanggan"))</p>
                            </a>
                        </li>

                        <!-- Katalog Menu (Always for User, and Staff can preview) -->
                        <li class="nav-item">
                            <a href="@Url.Action("Katalog", "Pesanan")" class="nav-link @(currentController == "Pesanan" && currentAction == "Katalog" ? "active" : "")">
                                <i class="nav-icon fas fa-book-open"></i>
                                <p>Katalog Menu</p>
                            </a>
                        </li>

                        <!-- Keranjang Belanja (For User) -->
                        @if (role == "User")
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Cart")" class="nav-link @(currentController == "Cart" ? "active" : "")">
                                    <i class="nav-icon fas fa-shopping-basket"></i>
                                    <p>
                                        Keranjang
                                        @if (cartItemCount > 0)
                                        {
                                            <span class="badge badge-danger ml-auto font-weight-bold" style="border-radius: var(--radius-pill); font-size: 0.72rem; padding: 2px 8px;">@cartItemCount</span>
                                        }
                                    </p>
                                </a>
                            </li>
                        }

                        <!-- Pesanan (Customer: Pesanan Saya, Staff: Kelola Semua Pesanan) -->
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Pesanan")" class="nav-link @(currentController == "Pesanan" && currentAction == "Index" ? "active" : "")">
                                <i class="nav-icon fas fa-receipt"></i>
                                <p>@(role == "User" ? "Pesanan Saya" : "Kelola Pesanan")</p>
                            </a>
                        </li>

                        @if (role == "Pemilik Toko" || role == "Karyawan")
                        {
                            <!-- Manifes Dapur Kolektif -->
                            <li class="nav-item">
                                <a href="@Url.Action("ManifesDapur", "Pesanan")" class="nav-link @(currentController == "Pesanan" && currentAction == "ManifesDapur" ? "active" : "")">
                                    <i class="nav-icon fas fa-fire-burner text-warning"></i>
                                    <p>Manifes Dapur</p>
                                </a>
                            </li>

                            <!-- Pesanan Manual / Walk-in -->
                            <li class="nav-item">
                                <a href="@Url.Action("Create", "Pesanan")" class="nav-link @(currentController == "Pesanan" && currentAction == "Create" ? "active" : "")">
                                    <i class="nav-icon fas fa-cash-register text-info"></i>
                                    <p>Pesanan Manual</p>
                                </a>
                            </li>

                            <li class="nav-header text-uppercase text-muted font-weight-bold px-3 mt-3 mb-1" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                                Manajemen Produk
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("Index", "PaketMenu")" class="nav-link @(currentController == "PaketMenu" ? "active" : "")">
                                    <i class="nav-icon fas fa-utensils"></i>
                                    <p>Kelola Paket Menu</p>
                                </a>
                            </li>
                        }

                        @if (role == "Pemilik Toko")
                        {
                            <li class="nav-header text-uppercase text-muted font-weight-bold px-3 mt-3 mb-1" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                                Pengaturan Pemilik Toko
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("Index", "KategoriMenu")" class="nav-link @(currentController == "KategoriMenu" ? "active" : "")">
                                    <i class="nav-icon fas fa-tags"></i>
                                    <p>Kelola Kategori Menu</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Pengguna")" class="nav-link @(currentController == "Pengguna" ? "active" : "")">
                                    <i class="nav-icon fas fa-users-cog"></i>
                                    <p>Kelola Pengguna</p>
                                </a>
                            </li>
                        }

                        <!-- Logout Link in Sidebar -->
                        <li class="nav-item mt-4 pt-2 border-top border-secondary">
                            <a href="@Url.Action("Logout", "Account")" class="nav-link text-danger" onclick="return confirm('Apakah Anda yakin ingin keluar dari sesi?');">
                                <i class="nav-icon fas fa-sign-out-alt text-danger"></i>
                                <p>Keluar</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="content-wrapper p-3 p-md-4">
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Modern Clean Footer -->
        <footer class="main-footer border-top bg-white text-muted small py-3 px-4">
            <div class="float-right d-none d-sm-inline">
                <i class="fas fa-shield-alt text-success mr-1"></i> Halal &amp; Higienis
            </div>
            <strong>&copy; @DateTime.Now.Year <a href="@Url.Action("Index", "Home")" class="text-danger font-weight-bold">Catering Mimi Saripah</a>.</strong> Desa Tenajar Lor, Kec. Kertasemaya, Kab. Indramayu.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": false,
                "positionClass": "toast-top-right",
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "4500",
                "extendedTimeOut": "1000"
            };
            
            @if (TempData["Success"] != null)
            {
                <text>toastr.success("@TempData["Success"]");</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>toastr.error("@TempData["Error"]");</text>
            }
            @if (TempData["Warning"] != null)
            {
                <text>toastr.warning("@TempData["Warning"]");</text>
            }
            @if (TempData["Info"] != null)
            {
                <text>toastr.info("@TempData["Info"]");</text>
            }

            // Global SweetAlert2 confirmation dialog for Native confirm() replacements
            $('a[onclick*="confirm("], button[onclick*="confirm("], input[type="submit"][onclick*="confirm("]').each(function() {
                var element = $(this);
                var onclickAttr = element.attr('onclick');
                var match = onclickAttr.match(/confirm\(['"](.*?)['"]\)/);
                var message = match ? match[1] : "Apakah Anda yakin?";
                
                element.removeAttr('onclick');
                
                element.click(function(e) {
                    e.preventDefault();
                    
                    Swal.fire({
                        title: 'Konfirmasi Tindakan',
                        text: message,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Ya, Lanjutkan',
                        cancelButtonText: 'Batal',
                        customClass: {
                            confirmButton: 'btn btn-modern-primary px-4 mx-2',
                            cancelButton: 'btn btn-modern-outline px-4 mx-2'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            var href = element.attr('href');
                            if (href && href !== '#') {
                                window.location.href = href;
                            } else {
                                var form = element.closest('form');
                                if (form.length) {
                                    form.submit();
                                }
                            }
                        }
                    });
                });
            });
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>