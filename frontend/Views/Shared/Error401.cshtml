@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var role = session?.GetString("Role");
    bool isGuest = string.IsNullOrEmpty(role);
    Layout = isGuest ? "~/frontend/Views/Shared/_GuestLayout.cshtml" : "_Layout";
    ViewData["Title"] = "401 - Sesi Belum Masuk";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="py-4">
                <div class="display-1 font-weight-bold text-warning mb-3 fw-bold">401</div>
                <h3 class="font-weight-bold text-dark mb-3 fw-bold">
                    <i class="fas fa-lock text-warning me-2"></i> Silakan Masuk ke Akun Anda Terlebih Dahulu
                </h3>
                <p class="text-muted mb-4 lead" style="font-size: 1.05rem;">
                    Anda harus masuk (login) menggunakan akun Anda terlebih dahulu untuk dapat mengakses halaman atau fitur ini.
                </p>
                <div class="d-flex justify-content-center flex-wrap" style="gap: 12px;">
                    <a href="@Url.Action("Login", "Account")" class="btn btn-danger px-4 py-2 rounded-pill font-weight-bold mx-2 my-1">
                        <i class="fas fa-sign-in-alt me-1 mr-1"></i> Masuk Sekarang
                    </a>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4 py-2 rounded-pill mx-2 my-1">
                        <i class="fas fa-home me-1 mr-1"></i> Ke Beranda
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
